# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out

# Dependency directories
/vendor/

# go.work / go.work.sum 提交入库（三 module：主仓 + genproto + sdk/go）；
# 勿在此忽略。

# Built binaries (mise build -> ./bin/)
/bin/
/fleetlyd
/fleetly

# 本地开发数据根（SQLite/密钥等，随部署形态落在数据根目录）
/data/

# Local config product (config-example.yaml is the committed template)
/config.yaml

# Editors / OS
.idea/
.vscode/
.DS_Store

# Console（N2 批次引入；依赖与构建产物可由 lockfile 复现）
console/node_modules/
console/dist/

# e2e 本地工作产物（中断跑批的日志/二进制）
.e2ebin/

# 离线 proto 生成的钉版本地插件（buf.gen.local.yaml 消费；buf.build
# remote 不可达时的生成通道——重装：go install 至 GOBIN=.tmp-bin）
.tmp-bin/

# 真机验证/升级的临时脚本与二进制（.n0-* 系列）
.n0-*/

.zcode/

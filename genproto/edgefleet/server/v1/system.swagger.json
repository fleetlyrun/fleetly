{
  "swagger": "2.0",
  "info": {
    "title": "edgefleet/server/v1/system.proto",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "SystemService"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/v1/system/ping": {
      "get": {
        "operationId": "SystemService_Ping",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1PingResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "tags": [
          "SystemService"
        ]
      }
    }
  },
  "definitions": {
    "v1ErrorResponse": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "title": "稳定错误码字符串（如 \"E_COMPOSE_INVALID\"），注册表校验只增。"
        },
        "message": {
          "type": "string",
          "title": "人读错误信息（面向运维/集成方，不承诺文案稳定）。"
        },
        "phase": {
          "type": "string",
          "title": "失败所处发布阶段（如 resolve / build / deploy / serve）。"
        },
        "deployment_id": {
          "type": "string",
          "title": "关联的部署 ID（无关联时为空）。"
        },
        "suggestion": {
          "type": "string",
          "title": "可执行的修复建议（面向用户展示）。"
        },
        "context": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "title": "结构化附加上下文（machine-readable 键值对）。"
        },
        "docs": {
          "type": "string",
          "title": "相关文档 URL（错误码文档锚点）。"
        }
      },
      "title": "ErrorResponse 是 edgefleet 对外错误信封的唯一契约定义（发布专项 §2.7、\n架构 D21）：gateway HTTPErrorHandler（阶段 3 落地）将 gRPC 错误统一渲染\n为本结构，snake_case JSON 输出；code 与 T0.2 错误码注册表（唯一真源，\n只增不复用）对齐。"
    },
    "v1PingResponse": {
      "type": "object",
      "properties": {
        "service": {
          "type": "string",
          "title": "应答服务名（恒 \"edgefleetd\"）。"
        },
        "version": {
          "type": "string",
          "title": "服务版本（构建 -ldflags 注入，未注入时为 \"dev\"）。"
        }
      }
    }
  }
}

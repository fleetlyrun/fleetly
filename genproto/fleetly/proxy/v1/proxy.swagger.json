{
  "swagger": "2.0",
  "info": {
    "title": "Proxy \u0026 TLS 上下文（领域模型 §2）：Route 与证书资产。",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "RoutesService"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/v1/routes": {
      "get": {
        "operationId": "RoutesService_ListRoutes",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListRoutesResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "project_id",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "after_route_seq",
            "description": "after_route_seq 游标（上一页末条 seq；0 = 首页）。游标轴 = seq 创建\n序升序（既有响应序不变；ADR-0026 after_* + limit 惯例——project/\nTeam 过滤语义不变，与游标叠加）。",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "int64"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          }
        ],
        "tags": [
          "RoutesService"
        ]
      },
      "post": {
        "operationId": "RoutesService_CreateRoute",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1CreateRouteResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1CreateRouteRequest"
            }
          }
        ],
        "tags": [
          "RoutesService"
        ]
      }
    },
    "/v1/routes/{id}": {
      "delete": {
        "operationId": "RoutesService_DeleteRoute",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1DeleteRouteResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "RoutesService"
        ]
      }
    }
  },
  "definitions": {
    "v1CreateRouteRequest": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string",
          "title": "五要素必填：路由 = Project 内 host(+path) → App Process 端口的映射，\n缺一即无完整发布目标（各字段独立报缺，组合检查拆 per-field）。"
        },
        "host": {
          "type": "string",
          "title": "host/path 语义校验（白名单字符集，traefik 规则反引号定界注入防线）\n在服务内执法——本面只钉在场性。"
        },
        "path": {
          "type": "string"
        },
        "app_id": {
          "type": "string"
        },
        "process": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "format": "int32",
          "title": "port 必填（正整数；0 = 未声明，负值一并拒绝）。"
        },
        "protocol": {
          "type": "string",
          "title": "protocol: http | h2c | tcp（默认 http）。"
        },
        "tls_mode": {
          "type": "string",
          "title": "tls_mode: auto（ACME）| none。"
        }
      }
    },
    "v1CreateRouteResponse": {
      "type": "object",
      "properties": {
        "route": {
          "$ref": "#/definitions/v1Route"
        }
      }
    },
    "v1DeleteRouteResponse": {
      "type": "object"
    },
    "v1ListRoutesResponse": {
      "type": "object",
      "properties": {
        "routes": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1Route"
          }
        }
      }
    },
    "v1Route": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "seq": {
          "type": "string",
          "format": "int64",
          "title": "seq 是创建序（ADR-0070：id 后缀即此号；分页游标轴）。"
        },
        "project_id": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "app_id": {
          "type": "string"
        },
        "process": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "format": "int32"
        },
        "protocol": {
          "type": "string"
        },
        "tls_mode": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        }
      },
      "title": "Route 是 host/path → Process 端口的映射（协议 http/h2c/tcp + TLS 模式）。"
    }
  }
}

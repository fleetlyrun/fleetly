            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "RunsService"
        ]
      }
    },
    "/v1/runs/{id}/stop": {
      "post": {
        "summary": "StopRun 停止单条 Run（stopped_by_user；resident 池下一拍补位）。",

          }
        ],
        "tags": [
          "RunsService"
        ]
      }
    },
    "/v1/runs/{id}/wait": {
      "get": {
        "summary": "WaitRun 是等待原语（架构 §7）：逐状态快照帧，终态（stopped/failed）\n帧后收流。流面豁免 unary 超时（与 WaitDeployment/WaitBuild 同款）。",
        "operationId": "RunsService_WaitRun",
        "responses": {
          "200": {
            "description": "A successful response.(streaming responses)",
            "schema": {
              "type": "object",
              "properties": {
                "result": {
                  "$ref": "#/definitions/v1WaitRunResponse"
                }
              },
              "title": "Stream result of v1WaitRunResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "RunsService"
        ]
      }
    },
    "/v1/schedules": {
      "get": {
        "summary": "ListSchedules 新→旧分页（游标 = ULID 创建序；含 tombstone——终态\n事实可见，与 ListTasks 同款）。",
        "operationId": "SchedulesService_ListSchedules",
        "responses": {
          "200": {
            "description": "A successful response.",

            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "SchedulesService"
        ]
      },
      "delete": {
        "summary": "DeleteSchedule 删除（tombstone；幂等）。已铸出的 Task 不受影响——\n跑完自然收口（Schedule 只拥有\"何时拍\"，不拥有在途执行）。",
        "operationId": "SchedulesService_DeleteSchedule",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1DeleteScheduleResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "SchedulesService"
        ]
      }
    },
    "/v1/schedules/{id}/trigger": {
      "post": {
        "summary": "TriggerSchedule 手动触发（RunNow 语义）：立即铸一拍 Task；cron 节奏\n不动。上一拍 Run 未终态时拒绝（先停上一拍或等其收口）。",
        "operationId": "SchedulesService_TriggerSchedule",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1TriggerScheduleResponse"
            }
          },
          "default": {

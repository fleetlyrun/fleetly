    "v1CreateScheduleRequest": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "title": "name 是项目内人读名（可选；活跃期唯一）。"
        },
        "cron": {
          "type": "string",
          "title": "cron 是 5 字段表达式（必填）。"
        },
        "timezone": {
          "type": "string",
          "title": "timezone 是 IANA 时区名（空 = UTC）。"
        },
        "image": {
          "type": "string",
          "title": "以下为冻结 TaskSpec 模板字段（每拍铸 one-shot Task 继承）。"
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "secret_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cpu_millis": {
          "type": "string",
          "format": "int64"
        },
        "memory_mb": {
          "type": "string",
          "format": "int64"
        },
        "ttl_seconds": {
          "type": "string",
          "format": "int64",
          "title": "ttl_seconds 是每拍 Run 的生命周期上限（上限 86400；0 = 无 TTL）。"
        },
        "network_group": {
          "type": "string"
        },
        "idempotency_key": {
          "type": "string"
        }
      }
    },
    "v1CreateScheduleResponse": {
      "type": "object",
      "properties": {
        "schedule": {
          "$ref": "#/definitions/v1Schedule"
        }
      }
    },
    "v1CreateTaskRequest": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "title": "name 是项目内人读名（可选；活跃期唯一）。"
        },
        "form": {
          "type": "string",
          "title": "form 双形态：one-shot | resident（空 = 按 desired_concurrency 推导）。"
        },
        "image": {
          "type": "string",
          "title": "image 镜像直部署引用（私有仓库凭证经 Secret \"registry:\u003chost\u003e\" 解析）。"
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "title": "env 是非敏感环境变量（归一化结果；敏感值走 secret_refs）。"
        },
        "secret_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cpu_millis": {
          "type": "string",
          "format": "int64",
          "title": "resources 是每 Run 资源上限。"
        },
        "memory_mb": {
          "type": "string",
          "format": "int64"
        },
        "ttl_seconds": {
          "type": "string",
          "format": "int64",
          "title": "ttl_seconds 是 Run 生命周期上限（绝对 deadline 落库，ADR-0018；上限\n86400；0 = 无 TTL）。"
        },
        "desired_concurrency": {
          "type": "string",
          "format": "int64",
          "title": "desired_concurrency 是 resident 期望并发 Run 数（one-shot 恒 1）。"
        },
        "network_group": {
          "type": "string",
          "title": "network_group 是 Task Network Group 名（Run 创建时刻挂靠；App Process\n经 taskGroup:\u003cname\u003e 跨挂）。"
        },
        "owner_token_id": {
          "type": "string",
          "title": "owner_token_id 是属主 Token 行引用（缺省 = 调用方 Token；吊销触发\n宽限排空，ADR-0017）。"
        },
        "idempotency_key": {
          "type": "string"
        }
      }
    },

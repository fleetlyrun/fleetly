{
  "swagger": "2.0",
  "info": {
    "title": "Automation 上下文（领域模型 §2）：程序化工作负载面——Task（one-shot/\nresident 双形态）、Run 与 Owner Lease（ADR-0012/0025）。DNS 名是平台\nAPI 面：per-Task 池级稳定名（活 Run 轮询解析）+ per-Run 稳定名。",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "TasksService"
    },
    {
      "name": "RunsService"
    },
    {
      "name": "SchedulesService"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/v1/runs": {
      "get": {
        "summary": "ListRuns 新→旧分页（游标 = ULID 创建序；task_id 过滤可选）。",
        "operationId": "RunsService_ListRuns",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListRunsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "task_id",
            "description": "task_id 过滤（与 project_id 二选一——无过滤的全平台 Run 列表是跨 Team\n泄漏面，ADR-0035 起强制过滤）。",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "after_run_id",
            "description": "after_run_id 游标（上一页末条 id；空 = 首页）。",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "project_id",
            "description": "project_id 过滤（ADR-0035 only-add；与 task_id 互斥）。",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "RunsService"
        ]
      }
    },

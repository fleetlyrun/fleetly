            "required": false,
            "type": "string"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          }
        ],
        "tags": [
          "SchedulesService"
        ]
      },
      "post": {
        "summary": "CreateSchedule 建周期触发规则：5 字段 cron 表达式 + IANA 时区名\n（空 = UTC；跨夏令时按墙钟解释，ADR-0018）。首拍时刻按表达式即刻\n铸出（next_fire_at 绝对时刻落行）。",
        "operationId": "SchedulesService_CreateSchedule",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1CreateScheduleResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1CreateScheduleRequest"
            }
          }
        ],
        "tags": [
          "SchedulesService"
        ]
      }
    },
    "/v1/schedules/{id}": {
      "get": {
        "operationId": "SchedulesService_GetSchedule",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1GetScheduleResponse"
            }
          },
          "default": {

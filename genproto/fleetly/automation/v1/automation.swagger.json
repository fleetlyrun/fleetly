          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/SchedulesServiceTriggerScheduleBody"
            }
          }
        ],
        "tags": [
          "SchedulesService"
        ]
      }
    },

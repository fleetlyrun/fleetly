{
  "swagger": "2.0",
  "info": {
    "title": "Templates 子面（F3.3，ADR-0050）：App 模板目录与一键部署。Template 是\n平台全局内容寻址目录文档（内嵌 + 刷新快照，非资源行）；InstantiateTemplate\n是服务端 create-or-reuse 编排——渲染走既有 Deploy 链（admission/审计/\n事件全复用，零新部署轨）。RefreshTemplates 是目录热更新动词（\"CDN\"的\nfleetly 形态：可配置 base URL + 内容寻址清单 + 显式刷新，非后台轮询）。",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "TemplatesService"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/v1/templates": {
      "get": {
        "summary": "ListTemplates 列目录（当前服务源：内嵌或最近刷新快照）。平台全局读面\n——无行级归属。",
        "operationId": "TemplatesService_ListTemplates",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListTemplatesResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "tags": [
          "TemplatesService"
        ]
      }
    },
    "/v1/templates/instantiate": {
      "post": {
        "summary": "InstantiateTemplate 一键部署：模板 + values → create-or-reuse 序\n（App/网络/Secret/Database）→ 渲染 → 既有 Deploy 链 → Route。响应逐\n资源报 created|reused；重跑按名收敛（不旋转密码）。等待是调用方的\n事（部署引用已返回）。",
        "operationId": "TemplatesService_InstantiateTemplate",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1InstantiateTemplateResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1InstantiateTemplateRequest"
            }
          }
        ],
        "tags": [
          "TemplatesService"
        ]
      }
    },
    "/v1/templates/refresh": {
      "post": {
        "summary": "RefreshTemplates 刷新目录（操作员动词）：拉取配置的 catalog URL →\ndigest 核对 + 全量预校验 → 原子覆盖快照（fail-closed：坏目录不换好\n目录）。未配置 catalog URL = 精确拒绝（内嵌目录即全部）。",
        "operationId": "TemplatesService_RefreshTemplates",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1RefreshTemplatesResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1RefreshTemplatesRequest"
            }
          }
        ],
        "tags": [
          "TemplatesService"
        ]
      }
    },
    "/v1/templates/{name}": {
      "get": {
        "summary": "GetTemplate 读单条（含模板体原文——插值前，无 secret 材料）。",
        "operationId": "TemplatesService_GetTemplate",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1GetTemplateResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "TemplatesService"
        ]
      }
    }
  },
  "definitions": {
    "v1GetTemplateResponse": {
      "type": "object",
      "properties": {
        "template": {
          "$ref": "#/definitions/v1Template"
        },
        "body": {
          "type": "string",
          "title": "body 是模板 YAML 原文（x-fleetly-template 声明 + compose 子集；插值\n前形态，无 secret 材料）。"
        }
      }
    },
    "v1InstantiateTemplateRequest": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string"
        },
        "template": {
          "type": "string",
          "title": "template 是目录键（如 \"nginx\"）。"
        },
        "app_name": {
          "type": "string",
          "title": "app_name 是目标 App 名（create-or-reuse：同名活跃 App 直接复用——\n重跑即重部署，latest-wins）。"
        },
        "values": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "title": "values 是 string/domain 型变量值（secret 型携带即拒——平台铸造）。"
        }
      }
    },
    "v1InstantiateTemplateResponse": {
      "type": "object",
      "properties": {
        "app_id": {
          "type": "string"
        },
        "deployment_id": {
          "type": "string"
        },
        "template_version": {
          "type": "string",
          "title": "template_version 是本次实例化消费的模板版本（审计锚）。"
        },
        "resources": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1InstantiatedResource"
          }
        }
      }
    },
    "v1InstantiatedResource": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "title": "kind 是 app | network | secret | database | route | deployment。"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "reused": {
          "type": "boolean",
          "title": "reused 为 true 表示同名既有资源直接复用（未新建——幂等重跑面）。"
        }
      },
      "title": "InstantiatedResource 是实例化报告的一条资源行。"
    },
    "v1ListTemplatesResponse": {
      "type": "object",
      "properties": {
        "templates": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1Template"
          }
        },
        "source": {
          "type": "string",
          "title": "source 是当前服务源：builtin（内嵌目录）| refreshed（最近刷新快照）。"
        }
      }
    },
    "v1RefreshTemplatesRequest": {
      "type": "object"
    },
    "v1RefreshTemplatesResponse": {
      "type": "object",
      "properties": {
        "previous_digest": {
          "type": "string",
          "title": "previous_digest 是刷新前服务目录 digest（内嵌目录的 digest 或旧快照\ndigest；首次刷新前无快照 = 内嵌目录聚合 digest）。"
        },
        "digest": {
          "type": "string",
          "title": "digest 是新快照聚合 digest（条目 digest 的聚合）。"
        },
        "template_count": {
          "type": "integer",
          "format": "int32"
        }
      }
    },
    "v1Template": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "title": "digest 是模板体 sha256（刷新核对与回显锚）。"
        },
        "description": {
          "type": "string"
        },
        "variables": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1TemplateVariable"
          }
        }
      }
    },
    "v1TemplateVariable": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "title": "type 是 string | secret | domain：string 插值进 compose 文本；secret\n平台铸造随机密码（值永不出现在渲染产物——文件注入）；domain 驱动\nRoute（与模板 routes 声明联动）。"
        },
        "description": {
          "type": "string"
        },
        "default": {
          "type": "string",
          "title": "default 是缺省值（secret 型恒缺省——平台铸造，不可设置）。"
        },
        "required": {
          "type": "boolean"
        }
      },
      "title": "TemplateVariable 是一条语义变量声明（ADR-0050 决策 2 三型）。"
    }
  }
}

        "status": {
          "type": "string"
        },
        "dns_name": {
          "type": "string",
          "title": "dns_name 是 private DNS 名（fn-\u003cid\u003e，行 id 派生——与 exposure 无关\n的永久属性，设计 v3 §6 三律①）。"
        },
        "private_url": {
          "type": "string"
        },
        "public_host": {
          "type": "string",
          "title": "public_host 是 public 暴露的配置 host（exposure=public 时非空——\n唤醒组件的 host→行映射与对账面的原始值；public_url 是其渲染形态）。"
        },
        "public_url": {
          "type": "string",
          "title": "public_url 仅 exposure=public 时非空（合成路由无 Route 行）。"
        },
        "exposure": {
          "type": "string",
          "title": "exposure 双态 private|public（缺省 private；可扩展枚举非布尔，设计\nv3 §6 三律③）。"
        },
        "replicas": {
          "type": "string",
          "format": "int64",
          "title": "容量三列（行面旋钮；v1 校验 0 ≤ min ≤ max ≤ 16，min ≥ 1——0 的\n语义位是 Phase 2 scale-to-zero，届时开放值域，设计 §8）。"
        },
        "min_replicas": {
          "type": "string",
          "format": "int64"
        },
        "max_replicas": {
          "type": "string",
          "format": "int64"
        },
        "idle_timeout_secs": {
          "type": "string",
          "format": "int64",
          "title": "idle_timeout_secs 是缩零/缩容防抖窗行旋钮（P2-2 决策环；0 = 平台缺省\n300s——容量平面行面旋钮，与 replicas/min/max 同族）。"
        },
        "current_revision_seq": {
          "type": "string",
          "format": "int64",
          "title": "current_revision_* 是在服 Revision 锚（current_revision_id 行列的\n响应面投影；digest 前 12 形态）。"
        },
        "current_revision_digest": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        }
      },
      "title": "Function 是聚合行响应面。state 生命周期 = active|deleted（幂等\ntombstone，响应面只呈活跃行）；status 是观测缓存\n（pending|running|degraded|stopped——wire-gen 匹配才采信，零状态类\n事件，设计 §4.1）。"
    },
    "v1FunctionRevision": {
      "type": "object",
      "properties": {
        "seq": {
          "type": "string",
          "format": "int64"
        },
        "digest": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        }
      },
      "title": "FunctionRevision 是冻结体行（不可变；保留窗内可见——每函数最近 100，\nADR-0101）。"
    },
    "v1GetFunctionResponse": {
      "type": "object",
      "properties": {
        "function": {
          "$ref": "#/definitions/v1Function"
        }
      }
    },
    "v1HealthcheckSpec": {
      "type": "object",
      "properties": {
        "http_path": {
          "type": "string"
        },
        "tcp_port": {
          "type": "integer",
          "format": "int32"
        },
        "exec": {
          "$ref": "#/definitions/v1ExecProbe"
        },
        "interval": {
          "type": "string"
        },
        "timeout": {
          "type": "string"
        },
        "start_period": {
          "type": "string"
        },
        "retries": {
          "type": "integer",
          "format": "int32"
        }
      },
      "title": "HealthcheckSpec 是声明式探针（三选一 + 节律）。"
    },
    "v1ListFunctionRevisionsResponse": {
      "type": "object",
      "properties": {
        "revisions": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1FunctionRevision"
          }
        }
      }
    },
    "v1ListFunctionsResponse": {
      "type": "object",
      "properties": {
        "functions": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1Function"
          }
        }
      }
    },
    "v1Protocol": {
      "type": "string",
      "enum": [
        "PROTOCOL_UNSPECIFIED",
        "PROTOCOL_HTTP",
        "PROTOCOL_H2C",
        "PROTOCOL_TCP"
      ],
      "default": "PROTOCOL_UNSPECIFIED",
      "title": "Protocol 是 Route/端口协议（http/h2c/tcp）。"
    },
    "v1ResolveFunctionBackendResponse": {
      "type": "object",
      "properties": {
        "ready": {
          "type": "boolean",
          "title": "ready = 后端是函数载体（true）还是唤醒扣留面（false，parked）。"
        },
        "addr": {
          "type": "string",
          "title": "addr 是后端地址（host:port；ready=false 时为唤醒组件在项目网上的\n端点——载具名经平台解析，调用方不感知 Provider 私有命名）。"
        }
      }
    },
    "v1ResourcesSpec": {
      "type": "object",
      "properties": {
        "cpu_millis": {
          "type": "string",
          "format": "int64",
          "title": "cpu_millis 毫核（1000 = 1 CPU）。"
        },
        "memory_mb": {
          "type": "string",
          "format": "int64"
        }
      },
      "title": "ResourcesSpec 是每副本资源上限（v1 仅每 Process 上限）。"
    },
    "v1RollbackFunctionResponse": {
      "type": "object",
      "properties": {
        "function": {
          "$ref": "#/definitions/v1Function"
        }
      }
    },
    "v1ScaleFunctionResponse": {
      "type": "object",
      "properties": {
        "function": {
          "$ref": "#/definitions/v1Function"
        }
      }
    },
    "v1SetFunctionExposureResponse": {
      "type": "object",
      "properties": {
        "function": {
          "$ref": "#/definitions/v1Function"
        }
      }
    },
    "v1WaitFunctionResponse": {
      "type": "object",
      "properties": {
        "function": {
          "$ref": "#/definitions/v1Function"
        }
      },
      "title": "WaitFunctionResponse 是行状态快照帧；流在稳定态帧后关闭。"
    },
    "v1WakeFunctionResponse": {
      "type": "object",
      "properties": {
        "woken": {
          "type": "boolean",
          "title": "woken = 本调用落账了唤醒（false = 已醒 no-op 或并发他者已落）。"
        }
      }
    }
  }
}

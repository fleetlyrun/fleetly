        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "FunctionsService"
        ]
      },
      "delete": {
        "summary": "DeleteFunction 收口（冻结封禁；幂等 tombstone）：聚合终局即时全清\nfunction_revisions（ADR-0101 决策 4）；public 路由面即时撤。",
        "operationId": "FunctionsService_DeleteFunction",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1DeleteFunctionResponse"

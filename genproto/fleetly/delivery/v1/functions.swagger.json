        ]
      }
    },
    "/v1/functions/{function_id}/rollback": {
      "post": {
        "summary": "RollbackFunction 指回旧冻结 Revision（Replay——复用行不新增，内容\n寻址断言）；缺省目标 = 上一成功 Revision。目标须在保留窗内（窗外\nE_NOT_FOUND + 保留策略 suggestion，ADR-0101 决策 7）。",
        "operationId": "FunctionsService_RollbackFunction",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1RollbackFunctionResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "function_id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/FunctionsServiceRollbackFunctionBody"
            }
          }
        ],
        "tags": [
          "FunctionsService"
        ]
      }
    },
    "/v1/functions/{function_id}/scale": {
      "post": {
        "summary": "ScaleFunction 是容量平面旋钮：行 CAS 钳 [min,max]，出界拒——零 Revision\n零重部署（scale-only，ADR-0064 红利：存量任务 ID 不变）。",
        "operationId": "FunctionsService_ScaleFunction",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ScaleFunctionResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "function_id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/FunctionsServiceScaleFunctionBody"
            }
          }
        ],
        "tags": [
          "FunctionsService"
        ]
      }
    },
    "/v1/functions/{function_id}/wait": {
      "get": {
        "summary": "WaitFunction 是收敛等待流：事件订阅为信号、行重读为真源（终态帧后\n收流；F1.3 形态）。expect_revision_seq 锚定换轨目标（0 = 任意稳定态）。",
        "operationId": "FunctionsService_WaitFunction",
        "responses": {
          "200": {
            "description": "A successful response.(streaming responses)",
            "schema": {
              "type": "object",
              "properties": {
                "result": {
                  "$ref": "#/definitions/v1WaitFunctionResponse"
                }
              },
              "title": "Stream result of v1WaitFunctionResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "function_id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "expect_revision_seq",
            "description": "expect_revision_seq 锚定换轨目标（0 = 任意稳定态帧）。",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "int64"
          }
        ],
        "tags": [
          "FunctionsService"
        ]
      }
    },
    "/v1/functions/{function_id}/wake": {
      "post": {
        "summary": "WakeFunction 是唤醒组件（activator）的内部窄动词（P2-1a，设计 v2\n§1.2/§1.6）：条件容量 CAS（0→rung，幂等/防踩踏）+ Kick 收敛环——\nactivator 永不触 Runtime。多请求并发恰一落账；已醒（replicas\u003e0）no-op。",
        "operationId": "FunctionsService_WakeFunction",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1WakeFunctionResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "function_id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/FunctionsServiceWakeFunctionBody"
            }
          }
        ],
        "tags": [
          "FunctionsService"
        ]
      }
    },
    "/v1/functions/{id}": {
      "get": {
        "operationId": "FunctionsService_GetFunction",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {

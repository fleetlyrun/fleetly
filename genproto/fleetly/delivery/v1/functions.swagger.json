  },
  "definitions": {
    "FunctionsServiceDeployFunctionBody": {
      "type": "object",
      "properties": {
        "image": {
          "type": "string"
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "secret_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "port": {
          "type": "integer",
          "format": "int32"
        },
        "port_protocol": {
          "$ref": "#/definitions/v1Protocol"
        },
        "healthcheck": {
          "$ref": "#/definitions/v1HealthcheckSpec"
        },
        "resources": {
          "$ref": "#/definitions/v1ResourcesSpec"
        }
      },
      "title": "DeployFunctionRequest 是全量替换面（源 + 形状；容量/接入不在此——\n三平面分立）。与 CreateFunctionRequest 同形字段逐字段镜像（缺\nproject/name/exposure/host 行面字段）。"
    },
    "FunctionsServiceRollbackFunctionBody": {
      "type": "object",
      "properties": {
        "revision_seq": {
          "type": "string",
          "format": "int64"
        }
      },
      "title": "RollbackFunctionRequest：revision_seq 缺省（0）= 回上一成功 Revision。"
    },
    "FunctionsServiceScaleFunctionBody": {
      "type": "object",
      "properties": {
        "replicas": {
          "type": "string",
          "format": "int64"
        },
        "idle_timeout_seconds": {
          "type": "string",
          "format": "int64",
          "title": "idle_timeout_seconds 是缩零/缩容防抖窗行旋钮（P2-2 决策环；0 = 不改\n行值——语义位与「行值 0 = 平台缺省 300s」分立：请求面 0 恒为\nleave-unchanged，行值才是容量真值）。"
        }
      },
      "title": "ScaleFunctionRequest：replicas 出 [min,max] 界即拒（E_INVALID_ARGUMENT\n+ suggestion；受理位单点执法、收敛环盲目，设计 §8）。0 仅对 min=0 函数\n合法（显式 park——正常缩零由决策环 idle 判定驱动，P2-2）。"
    },
    "FunctionsServiceSetFunctionExposureBody": {
      "type": "object",
      "properties": {
        "exposure": {
          "type": "string"
        },
        "host": {
          "type": "string",
          "title": "host 仅 exposure=public 消费（转 private 时忽略并清位）。"
        }
      }
    },
    "FunctionsServiceWakeFunctionBody": {
      "type": "object"
    },
    "v1Admission": {
      "type": "object",
      "properties": {
        "outcome": {
          "type": "string",
          "title": "outcome 四形态：queued（新受理，无合并无抢占）| merged（latest-wins：\n既有 queued 请求被本请求合并取代）| superseded（显式 supersede 抢占\n在途部署；同批合并的 queued 不另报）| deduplicated（同幂等键或同\ncommit 命中活跃既有部署）。幂等层命中（ADR-0024）逐字节重放原始\n响应、不标 deduplicated——幂等层与 admission 去重在响应里天然分立。"
        },
        "position": {
          "type": "integer",
          "format": "int32",
          "title": "position 是本部署在 per-App 串行管线中的位次（1 = 队头/下一执行）；\n在途部署在前计位，被合并/被抢占的不计。deduplicated 时是命中既有\n部署的位次。"
        },
        "existing_deployment": {
          "type": "string",
          "title": "existing_deployment 在 outcome=deduplicated 时携带命中的既有部署引用\n（与 deployment 字段同值——单独携带供程序化消费，不必比对）。"
        }
      },
      "title": "Admission 是创建型部署受理的判定附注（P10：ADR-0016 语义的响应面显式\n化——调用方（尤其 Agent）可判定\"去重命中/排队第几位\"，UI/API/webhook\n三入口一致）。"
    },
    "v1CreateFunctionRequest": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "image": {
          "type": "string",
          "title": "image 必填：v1 源 = image 直投（平台通用分母；私有仓凭证经 Secret\nregistry:\u003chost\u003e 既有通道）。"
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "secret_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "port": {
          "type": "integer",
          "format": "int32",
          "title": "port 必填：handler 进程监听口（恰一；protocol ∈ {http, h2c}）。"
        },
        "port_protocol": {
          "$ref": "#/definitions/v1Protocol",
          "title": "port_protocol 缺省归一 http（UNSPECIFIED → PROTOCOL_HTTP）。"
        },
        "healthcheck": {
          "$ref": "#/definitions/v1HealthcheckSpec"
        },
        "resources": {
          "$ref": "#/definitions/v1ResourcesSpec"
        },
        "min_replicas": {
          "type": "string",
          "format": "int64",
          "title": "min/max 容量旋钮（行面初值；跨字段 min ≤ max 由受理位单点执法，\n设计 §8——0 = 缺省归一 1；min=0 显式值 = scale-to-zero 使能（P2-1a，\n设计 v2 §1.3：idle 后 replicas 归 0，请求经唤醒组件唤醒））。"
        },
        "max_replicas": {
          "type": "string",
          "format": "int64"
        },
        "exposure": {
          "type": "string",
          "title": "exposure 缺省 private。"
        },
        "host": {
          "type": "string",
          "title": "host 仅 public 消费（缺省服务端拼装托管域；占用预检 E_CONFLICT）。"
        },
        "idle_timeout_seconds": {
          "type": "string",
          "format": "int64",
          "title": "idle_timeout_seconds 是缩零/缩容防抖窗行初值（P2-2 决策环；0 = 平台\n缺省 300s——min=0 函数建议显式声明短窗以便快速验证缩零链）。"
        }
      },
      "title": "CreateFunctionRequest 是创建即首部署的受理面。名字形状 = dns 标签\n（活跃期唯一，同名重建新 seq 新 id 永不复用，ADR-0070 名基）；活跃网络\n在场 fail-closed（零网项目 private 不可达即拒，ADR-0029 同款）；配额\nMaxFunctionsPerProject=50 + MaxFunctionReplicasPerProject=64（设计 §10）。"
    },
    "v1CreateFunctionResponse": {
      "type": "object",
      "properties": {
        "function": {
          "$ref": "#/definitions/v1Function"
        },
        "admission": {
          "$ref": "#/definitions/v1Admission",
          "title": "admission 复用部署受理判定（queued|merged|superseded|deduplicated\n——per-Function 串行语义，设计 §5）。"
        }
      }
    },

          {
            "name": "after_revision_seq",
            "description": "after_revision_seq 游标（上一页末条 seq；0 = 首页；升序）。",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "int64"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          }
        ],
        "tags": [

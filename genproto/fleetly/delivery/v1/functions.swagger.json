{
  "swagger": "2.0",
  "info": {
    "title": "Functions 产品线（ADR-0077 一等实体；设计真源 docs/design/\n2026-10-16-functions-api.md v3，实施 ADR-0102）：请求驱动的托管执行\n单元——单代码入口 + URL + 按需伸缩，调用语义（鉴权/载荷/幂等）归函数\n自己，平台语义（URL/伸缩/唤醒/观测）归 fleetly。创建即首部署（无空行，\nDatabase 先例）；容量与接入是行面旋钮（scale/exposure 翻转零重部署）；\npublic = 合成受管路由（无 Route 行）；不设平台转发 Invoke RPC——控制面\n不是数据面（设计 §5）。",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "FunctionsService"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/v1/functions": {
      "get": {
        "summary": "ListFunctions 按项目列活跃行（after_* + limit 游标，ADR-0026 惯例）。",
        "operationId": "FunctionsService_ListFunctions",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListFunctionsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "project_id",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "after_function_seq",
            "description": "after_function_seq 游标（上一页末条 seq；0 = 首页；升序）。",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "int64"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "exposure",
            "description": "exposure/state 可选过滤（空 = 不过滤）。",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "state",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "FunctionsService"
        ]
      },
      "post": {
        "summary": "CreateFunction 创建即首部署（幂等面 + 冻结封禁；idem 键重放逐字节\n同响应）。exposure 缺省 private（仅项目网成员资格可达）；public 需\nhost（缺省服务端拼装托管域）。",
        "operationId": "FunctionsService_CreateFunction",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1CreateFunctionResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1CreateFunctionRequest"
            }
          }
        ],
        "tags": [
          "FunctionsService"
        ]
      }
    },
    "/v1/functions/{function_id}/backend": {
      "get": {
        "summary": "ResolveFunctionBackend 是唤醒组件的后端解析面：replicas\u003e0 = 函数载体\n端点（期望集解析）；replicas=0 = 唤醒组件自身端点（parked 期请求扣留\n面）。唤醒组件的转发目标永不自拼载体名（Provider 私有纪律）。",
        "operationId": "FunctionsService_ResolveFunctionBackend",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ResolveFunctionBackendResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "function_id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "FunctionsService"
        ]
      }
    },
    "/v1/functions/{function_id}/deploy": {
      "post": {
        "summary": "DeployFunction 是全量替换（非 overlay——v1 无双物主，map/repeated\n缺席语义零歧义）：冻结新 Revision + current_revision_id 原子换轨；\n幂等面。容量/接入平面不动。",
        "operationId": "FunctionsService_DeployFunction",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1DeployFunctionResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "function_id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/FunctionsServiceDeployFunctionBody"
            }
          }
        ],
        "tags": [
          "FunctionsService"
        ]
      }
    },
    "/v1/functions/{function_id}/exposure": {
      "post": {
        "summary": "SetFunctionExposure 是接入平面旋钮：行写 + 路由面即时重发布，零载体\n动作。fn-\u003cid\u003e private 名永久（挂 public 时保留、撤后即时可用——设计\nv3 §6 三律）；exposure 是可扩展枚举非布尔。",
        "operationId": "FunctionsService_SetFunctionExposure",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1SetFunctionExposureResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "function_id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/FunctionsServiceSetFunctionExposureBody"
            }
          }
        ],
        "tags": [
          "FunctionsService"
        ]
      }
    },

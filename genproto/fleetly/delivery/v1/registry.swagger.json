{
  "swagger": "2.0",
  "info": {
    "title": "Registry 只读代理面（IA v3 二期⑤b）：受管镜像仓内容视图——/v2/_catalog\n与 tags/list 按项目凭证代理（Registry 页二期视图的数据源；§5.1）。仓库\n前纲 = \u003cproject_id\u003e/\u003capp_id\u003e 双段小写（buildRepo 单源），catalog 按前纲\n过滤、tags 校验归属——跨项目仓名不可达。内容面零状态迁移：纯读代理，\n大小/推送时刻从 manifest 诚实解析（index 形态不可得字段留空值）。",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "RegistryService"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/v1/registry/catalog": {
      "get": {
        "summary": "ListRegistryCatalog 列项目前纲下的仓名（受管仓库停用 = 精确失败）。",
        "operationId": "RegistryService_ListRegistryCatalog",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListRegistryCatalogResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "project_id",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "RegistryService"
        ]
      }
    },
    "/v1/registry/{repository}/tags": {
      "get": {
        "summary": "ListRegistryTags 列仓名下的 tag 清单（digest/压缩大小/推送时刻；\nmanifest index 形态的 tag 无可得大小/时刻——诚实留空）。",
        "operationId": "RegistryService_ListRegistryTags",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListRegistryTagsResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "repository",
            "description": "repository 是仓名（须落在该项目前纲下——越纲按 not found 拒绝）。",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "project_id",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "RegistryService"
        ]
      }
    }
  },
  "definitions": {
    "v1ListRegistryCatalogResponse": {
      "type": "object",
      "properties": {
        "repositories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "title": "repositories 是项目前纲下的仓名（全名含前纲，\u003cproject\u003e/\u003capp\u003e 小写）。"
        }
      }
    },
    "v1ListRegistryTagsResponse": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1RegistryTag"
          }
        }
      }
    },
    "v1RegistryTag": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "title": "digest 是 manifest 内容寻址（sha256:…；from_build 下发的拉取锚）。"
        },
        "size_bytes": {
          "type": "string",
          "format": "int64"
        },
        "pushed_at": {
          "type": "string"
        }
      },
      "title": "RegistryTag 是一个 tag 的内容事实（大小 = manifest config+layers 描述符\n之和，即压缩形态仓库占用；pushed_at 取 config created 注记，RFC3339）。"
    }
  }
}

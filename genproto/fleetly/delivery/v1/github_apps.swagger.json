{
  "swagger": "2.0",
  "info": {
    "title": "GitHub App 接入材料面（ADR-0073 阶段 B）：私有 Git 仓库的一等接入体。\n私钥 age 信封只写不读——读面只回指纹；Owner 受理即经 GitHub API 验证\n并自动解析（请求不携带属主）。双作用域：project_id（Project 级，行级\n授权）或 global（平台级，平台管理授权，全项目可用）；解析时 Project\n级遮蔽 Global。",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "GitHubAppsService"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/v1/github-apps": {
      "get": {
        "summary": "ListGitHubApps 按作用域列指纹面（project_id 或 global 二选一必填）。",
        "operationId": "GitHubAppsService_ListGitHubApps",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListGitHubAppsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "project_id",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "global",
            "in": "query",
            "required": false,
            "type": "boolean"
          }
        ],
        "tags": [
          "GitHubAppsService"
        ]
      },
      "post": {
        "summary": "SetGitHubApp 受理即验证：私钥签 JWT 读 installation 对象，校验三元\n组并解析属主后落库（错值精确报错，不等到首次构建）；同作用域同属主\n重复调用 = 覆盖更新（私钥轮换 = 重放 put）。明文只进受理与验证，\n响应与读面只回指纹。",
        "operationId": "GitHubAppsService_SetGitHubApp",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1SetGitHubAppResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1SetGitHubAppRequest"
            }
          }
        ],
        "tags": [
          "GitHubAppsService"
        ]
      }
    },
    "/v1/github-apps/manifest/complete": {
      "post": {
        "summary": "CompleteManifestFlow 以 setup 回调的 installation_id 落行（走既有受\n理即验证 + 密封 upsert；project_id 回传供冻结锚，须与 start 作用域一\n致，谎言即拒）。流一次性：complete 后 nonce 作废。",
        "operationId": "GitHubAppsService_CompleteManifestFlow",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1CompleteManifestFlowResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1CompleteManifestFlowRequest"
            }
          }
        ],
        "tags": [
          "GitHubAppsService"
        ]
      }
    },
    "/v1/github-apps/manifest/consume": {
      "post": {
        "summary": "ConsumeManifestCode 用一次性 code 换 App 凭据（私钥即收即封、暂存于\n流存储，15 分钟时效），返回安装页 URL——installation 在下一步落定。",
        "operationId": "GitHubAppsService_ConsumeManifestCode",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ConsumeManifestCodeResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1ConsumeManifestCodeRequest"
            }
          }
        ],
        "tags": [
          "GitHubAppsService"
        ]
      }
    },
    "/v1/github-apps/manifest/start": {
      "post": {
        "summary": "StartManifestFlow 生成 GitHub manifest 跳转 URL（state = HMAC 签名，\n绑作用域 + 15 分钟时效）。未配置公网 console 基址时精确失败（手动表\n单兜底）。",
        "operationId": "GitHubAppsService_StartManifestFlow",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1StartManifestFlowResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1StartManifestFlowRequest"
            }
          }
        ],
        "tags": [
          "GitHubAppsService"
        ]
      }
    },
    "/v1/github-apps/{id}": {
      "delete": {
        "summary": "DeleteGitHubApp 软删（tombstone；解析面即时失效）。",
        "operationId": "GitHubAppsService_DeleteGitHubApp",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1DeleteGitHubAppResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "GitHubAppsService"
        ]
      }
    },
    "/v1/github-apps/{id}/repos": {
      "get": {
        "summary": "ListGitHubAppRepos 现铸 token 列 installation 可达仓库（安装健康验证\n面；授权随行作用域）。",
        "operationId": "GitHubAppsService_ListGitHubAppRepos",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListGitHubAppReposResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "GitHubAppsService"
        ]
      }
    }
  },
  "definitions": {
    "v1CompleteManifestFlowRequest": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string"
        },
        "installation_id": {
          "type": "string",
          "format": "int64",
          "title": "installation_id 来自 setup 回调查询参数。"
        },
        "project_id": {
          "type": "string",
          "title": "project_id 回传 start 时的作用域（冻结锚与作用域一致性校验；global\n流留空）。"
        }
      }
    },
    "v1CompleteManifestFlowResponse": {
      "type": "object",
      "properties": {
        "app": {
          "$ref": "#/definitions/v1GitHubApp"
        }
      }
    },
    "v1ConsumeManifestCodeRequest": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "title": "code 是 GitHub 回调 redirect_url 携带的一次性兑换码（10 分钟有效）。"
        },
        "state": {
          "type": "string",
          "title": "state 是 start 返回流跳转链里原样带回的签名态（与 start 作用域绑定）。"
        }
      }
    },
    "v1ConsumeManifestCodeResponse": {
      "type": "object",
      "properties": {
        "install_url": {
          "type": "string",
          "title": "install_url 是该 App 的安装页地址（勾选仓库后 GitHub 回跳 setup_url\n并携带 installation_id）。"
        },
        "app_name": {
          "type": "string",
          "title": "app_name 是创建时的 App 名（GitHub 表单里用户可改）。"
        }
      }
    },
    "v1DeleteGitHubAppResponse": {
      "type": "object"
    },
    "v1GitHubApp": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "project_id": {
          "type": "string",
          "title": "project_id 空 = 平台级 Global。"
        },
        "app_id": {
          "type": "string",
          "format": "int64"
        },
        "installation_id": {
          "type": "string",
          "format": "int64"
        },
        "account_login": {
          "type": "string",
          "title": "account_login 受理时经 GitHub API 解析（系统填充，请求不携带）。"
        },
        "api_base": {
          "type": "string",
          "title": "api_base 空 = 缺省 github.com（GHES 携带完整基址）。"
        },
        "private_key_fingerprint": {
          "type": "string",
          "title": "private_key_fingerprint 是私钥指纹（sha256 前 16 hex）——明文永不回显。"
        },
        "created_at": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        }
      }
    },
    "v1GitHubAppRepo": {
      "type": "object",
      "properties": {
        "full_name": {
          "type": "string",
          "title": "full_name 是 \"owner/repo\" 全名。"
        },
        "private": {
          "type": "boolean"
        }
      }
    },
    "v1ListGitHubAppReposResponse": {
      "type": "object",
      "properties": {
        "repos": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1GitHubAppRepo"
          }
        }
      }
    },
    "v1ListGitHubAppsResponse": {
      "type": "object",
      "properties": {
        "apps": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1GitHubApp"
          }
        }
      }
    },
    "v1SetGitHubAppRequest": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string"
        },
        "global": {
          "type": "boolean"
        },
        "app_id": {
          "type": "string",
          "format": "int64"
        },
        "installation_id": {
          "type": "string",
          "format": "int64"
        },
        "private_key_pem": {
          "type": "string",
          "title": "private_key_pem 是 App 私钥 PEM 原文（PKCS#1/PKCS#8）——只进受理与\n验证，落库前密封，响应不回显。"
        },
        "api_base": {
          "type": "string"
        }
      }
    },
    "v1SetGitHubAppResponse": {
      "type": "object",
      "properties": {
        "app": {
          "$ref": "#/definitions/v1GitHubApp"
        }
      }
    },
    "v1StartManifestFlowRequest": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string"
        },
        "global": {
          "type": "boolean"
        }
      }
    },
    "v1StartManifestFlowResponse": {
      "type": "object",
      "properties": {
        "redirect_url": {
          "type": "string",
          "title": "redirect_url 是 github.com 的 manifest 创建页地址（含编码 manifest），\n调用方整页跳转。"
        },
        "state": {
          "type": "string",
          "title": "state 是签名流态（consume/complete 原样回传；调用方透明）。"
        }
      }
    }
  }
}

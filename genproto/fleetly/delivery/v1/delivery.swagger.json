    "v1CancelDeploymentResponse": {
      "type": "object",
      "properties": {
        "deployment": {
          "$ref": "#/definitions/v1Deployment"
        }
      }
    },
    "v1DeployRequest": {
      "type": "object",
      "properties": {
        "app_id": {
          "type": "string"
        },
        "image": {
          "type": "string",
          "title": "image 直投形态（如 nginx:1.27）。"
        },
        "compose_yaml": {
          "type": "string",
          "title": "compose_yaml 受控子集形态（白名单执法、受管字段显式拒绝）。"
        },
        "idempotency_key": {
          "type": "string"
        },
        "commit_sha": {
          "type": "string"
        },
        "supersede": {
          "type": "boolean"
        },
        "process_name": {
          "type": "string",
          "title": "process_name 覆盖直投形态的进程名（默认 web）。"
        },
        "http_probe": {
          "type": "string",
          "title": "http_probe/tcp_probe 是直投形态的探针声明（B2：http/tcp 探针的 API\n声明面，互斥；compose 形态经 healthcheck.http_path/tcp_port 扩展键）。"
        },
        "tcp_probe": {
          "type": "integer",
          "format": "int32"
        }
      },
      "title": "DeployRequest 两源（互斥；spec_file 已归一化 AppSpec JSON 随 API 扩展批）。"
    },
    "v1DeployResponse": {
      "type": "object",
      "properties": {
        "deployment": {
          "$ref": "#/definitions/v1Deployment"
        }
      }
    },
    "v1Deployment": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "app_id": {
          "type": "string"
        },
        "from_revision": {
          "type": "string"
        },
        "to_revision": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "generation": {
          "type": "string",
          "format": "uint64"
        },
        "idempotency_key": {
          "type": "string"
        },
        "commit_sha": {
          "type": "string"
        },
        "superseded_by": {
          "type": "string"
        },
        "error": {
          "type": "string"
        },
        "observe_deadline": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        },
        "finished_at": {
          "type": "string"
        }
      },
      "title": "Deployment 是受监督迁移的行形态（状态机值 kebab-case 与存储一致）。"
    },
    "v1DiffEntry": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "old_value": {
          "type": "string"
        },
        "new_value": {
          "type": "string"
        }
      }
    },
    "v1DiffRevisionsResponse": {
      "type": "object",
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1DiffEntry"
          }
        }
      }
    },
    "v1GetDeploymentResponse": {
      "type": "object",
      "properties": {
        "deployment": {
          "$ref": "#/definitions/v1Deployment"
        }
      }
    },
    "v1GetGitHookResponse": {
      "type": "object",
      "properties": {
        "hook": {
          "$ref": "#/definitions/v1GitHook"
        }
      }
    },
    "v1GitHook": {
      "type": "object",
      "properties": {
        "app_id": {
          "type": "string"
        },
        "repo": {
          "type": "string",
          "title": "仓库 URL（构建检出源）"
        },
        "branch": {
          "type": "string",
          "title": "分支过滤（空 = 全部分支；tag 一律不触发）"
        },
        "dockerfile": {
          "type": "string",
          "title": "构建文件路径（缺省 Dockerfile）"
        },
        "watch_paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "title": "触发路径前缀（空 = 全部变更触发）"
        },
        "token_prefix": {
          "type": "string",
          "title": "URL token 前缀（泄露识别锚）"
        },
        "created_at": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        }
      },
      "title": "GitHook 是 per-App Git 触发配置投影（secret 永不回显——完整明文只在\n铸造响应出现一次）。"
    },
    "v1ListBuildsResponse": {

    "v1SetGitHookResponse": {
      "type": "object",
      "properties": {
        "hook": {
          "$ref": "#/definitions/v1GitHook"
        },
        "secret": {
          "type": "string",
          "title": "secret 是完整明文（flthook_ 前缀），仅首次配置铸造时返回一次；同一串\n用作 GitHub 仓库的 webhook secret。"
        }
      }
    },
    "v1StreamBuildLogsResponse": {
      "type": "object",
      "properties": {

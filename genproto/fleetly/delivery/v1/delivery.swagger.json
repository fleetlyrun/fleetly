        "app_id": {
          "type": "string"
        },
        "seq": {
          "type": "string",
          "format": "int64"
        },
        "digest": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        }
      }
    },
    "v1RollbackResponse": {

{
  "swagger": "2.0",
  "info": {
    "title": "Delivery 上下文（领域模型 §2）：源接入、构建、Revision 冻结与 Deployment\n生命周期。Deploy 是一站式入口：两源归一化 → AppSpec 校验 → Revision\n冻结（内容寻址复用）→ admission（ADR-0016）。",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "DeploymentsService"
    },
    {
      "name": "RevisionsService"
    },
    {
      "name": "BuildsService"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/v1/apps/{app_id}/rollback": {
      "post": {
        "summary": "Rollback 是一等动词（F0.11）：Revision Replay——空目标回上一成功基线。",
        "operationId": "DeploymentsService_Rollback",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1RollbackResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "app_id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/DeploymentsServiceRollbackBody"
            }
          }
        ],
        "tags": [
          "DeploymentsService"
        ]
      }
    },

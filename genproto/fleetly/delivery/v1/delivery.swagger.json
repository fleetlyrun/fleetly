          }
        }
      }
    },
    "v1ReceiveWebhookResponse": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "title": "status: pong（ping 事件）| accepted | skipped | duplicate | ignored\n（非 ping/push 事件）。"
        },
        "reason": {
          "type": "string",
          "title": "skipped 细节（branch/path/skip 标记）"
        },
        "deployment_id": {
          "type": "string"
        }
      }
    },
    "v1Revision": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "app_id": {
          "type": "string"
        },
        "seq": {
          "type": "string",
          "format": "int64"
        },
        "digest": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        }
      }
    },
    "v1RollbackResponse": {
      "type": "object",
      "properties": {
        "deployment": {
          "$ref": "#/definitions/v1Deployment"
        }
      }
    },
    "v1RotateHookTokenResponse": {
      "type": "object",
      "properties": {
        "hook": {
          "$ref": "#/definitions/v1GitHook"
        },
        "secret": {
          "type": "string",
          "title": "新明文，仅此一次"
        }
      }
    },
    "v1SetGitHookResponse": {
      "type": "object",
      "properties": {
        "hook": {
          "$ref": "#/definitions/v1GitHook"
        },
        "secret": {
          "type": "string",
          "title": "secret 是完整明文（flthook_ 前缀），仅首次配置铸造时返回一次；同一串\n用作 GitHub 仓库的 webhook secret。"
        }
      }
    }

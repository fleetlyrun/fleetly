          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListDeploymentsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "app_id",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "DeploymentsService"
        ]
      },
      "post": {
        "summary": "Deploy 归一化两源（镜像直投 / Compose 受控子集）并受理部署。",
        "operationId": "DeploymentsService_Deploy",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1DeployResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1DeployRequest"
            }
          }
        ],
        "tags": [
          "DeploymentsService"
        ]
      }
    },
    "/v1/deployments/{id}": {
      "get": {
        "operationId": "DeploymentsService_GetDeployment",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1GetDeploymentResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "DeploymentsService"
        ]
      }
    },
    "/v1/deployments/{id}/cancel": {
      "post": {
        "operationId": "DeploymentsService_CancelDeployment",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1CancelDeploymentResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/DeploymentsServiceCancelDeploymentBody"
            }
          }
        ],
        "tags": [
          "DeploymentsService"
        ]
      }
    },
    "/v1/revisions": {
      "get": {
        "operationId": "RevisionsService_ListRevisions",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListRevisionsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "app_id",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "RevisionsService"
        ]
      }
    },
    "/v1/revisions/diff": {
      "get": {
        "summary": "DiffRevisions 输出两条 Revision 的字段级差异（路径字典序）。",
        "operationId": "RevisionsService_DiffRevisions",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1DiffRevisionsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "app_id",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "from_seq",
            "description": "from/to 是 App 内 Revision 序号（R1..Rn 对外形态）。",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "int64"
          },
          {
            "name": "to_seq",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "int64"
          }
        ],
        "tags": [
          "RevisionsService"
        ]
      }
    }
  },
  "definitions": {
    "DeploymentsServiceCancelDeploymentBody": {
      "type": "object"
    },

{
  "swagger": "2.0",
  "info": {
    "title": "Delivery 上下文（领域模型 §2）：源接入、构建、Revision 冻结与 Deployment\n生命周期。Deploy 是一站式入口：两源归一化 → AppSpec 校验 → Revision\n冻结（内容寻址复用）→ admission（ADR-0016）。",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "DeploymentsService"
    },
    {
      "name": "RevisionsService"
    },
    {
      "name": "BuildsService"
    },
    {
      "name": "HooksService"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/v1/apps/{app_id}/hook": {
      "get": {
        "operationId": "HooksService_GetGitHook",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1GetGitHookResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "app_id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "HooksService"
        ]
      },
      "post": {
        "summary": "SetGitHook 建/改配置；无 Token 时铸造（明文只在本响应出现一次，\n同一串兼作 GitHub webhook secret）。已配置过再 Set 只改配置不换 Token\n（换 Token 用 RotateHookToken）。",
        "operationId": "HooksService_SetGitHook",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1SetGitHookResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "app_id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/HooksServiceSetGitHookBody"
            }
          }
        ],
        "tags": [
          "HooksService"
        ]
      }
    },
    "/v1/apps/{app_id}/hook/rotate": {
      "post": {
        "summary": "RotateHookToken 吊销旧 Token 铸新（URL token 与 GitHub webhook secret\n同源双换；旧 Token 即刻失效）。",
        "operationId": "HooksService_RotateHookToken",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1RotateHookTokenResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "app_id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/HooksServiceRotateHookTokenBody"
            }
          }
        ],
        "tags": [
          "HooksService"
        ]
      }
    },
    "/v1/apps/{app_id}/rollback": {
      "post": {
        "summary": "Rollback 是一等动词（F0.11）：Revision Replay——空目标回上一成功基线。",
        "operationId": "DeploymentsService_Rollback",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1RollbackResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "app_id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/DeploymentsServiceRollbackBody"
            }
          }
        ],
        "tags": [
          "DeploymentsService"
        ]
      }
    },
    "/v1/builds": {
      "get": {

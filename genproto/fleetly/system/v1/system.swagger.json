{
  "swagger": "2.0",
  "info": {
    "title": "System 服务：控制面自身状态面（`fleetly status` / `fleetly doctor` 消费）。\n公开面——安装引导期（Bootstrap Token 尚未生成）无凭证可用；诊断信息不含\n敏感细节。",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "SystemService"
    },
    {
      "name": "PlatformService"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/v1/platform/backups": {
      "get": {
        "summary": "ListPlatformBackups 列举本地仓快照（restic snapshots 直读，零状态行\n——仓库自身即事实源，ADR-0039 决策 10）；新→旧分页（ADR-0026）。",
        "operationId": "PlatformService_ListPlatformBackups",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListPlatformBackupsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "after_snapshot_id",
            "description": "after_snapshot_id 游标（上一页末条快照短 id；空 = 首页）。",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          }
        ],
        "tags": [
          "PlatformService"
        ]
      },
      "post": {
        "summary": "TriggerPlatformBackup 立即同步执行一次 Platform Backup（不走节拍锚；\n执行时长受平台备份超时上界约束）。restic 缺席/链失败 = 精确失败。\n升级序的前置动词（ADR-0015：Platform Backup 前置）。在幂等执法面\n（ADR-0024；ADR-0039 决策 10）。",
        "operationId": "PlatformService_TriggerPlatformBackup",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1TriggerPlatformBackupResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1TriggerPlatformBackupRequest"
            }
          }
        ],
        "tags": [
          "PlatformService"
        ]
      }
    },
    "/v1/system/components/{name}/restart": {
      "post": {
        "summary": "RestartComponent 重启受管组件载体（IA v3 二期④，排障动线\"日志断了 →\n就地重启\"）：按 Provider 名路由（traefik/zot/victorialogs/\nvictoriametrics…），经 Runtime 重启原语逐 Workload 强制重排。\n未知名/非受管自宿 = 精确拒绝。",
        "operationId": "SystemService_RestartComponent",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1RestartComponentResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "name",
            "description": "name 是 Provider 名（与 GetStatus components 的 name 同域）。",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/SystemServiceRestartComponentBody"
            }
          }
        ],
        "tags": [
          "SystemService"
        ]
      }
    },
    "/v1/system/explain": {
      "get": {
        "summary": "Explain 返回单个资源的自描述（Spec 种类 \"app\"/\"task\"/\"database\" 或\n事件名 \"deployment.succeeded\"——`fleetly explain \u003c资源\u003e` 消费）。",
        "operationId": "SystemService_Explain",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ExplainResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "resource",
            "description": "resource 命名一条自描述条目（空或未知名 → E_INVALID_ARGUMENT /\nE_NOT_FOUND，报错信息给出清单入口）。",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "SystemService"
        ]
      }
    },
    "/v1/system/schema": {
      "get": {
        "summary": "GetSchema 返回能力自描述全量文档（Spec 契约 + 事件 payload JSON\nSchema，Go 类型反射生成——`fleetly schema` 消费；ADR-0026 形状钉扎）。",
        "operationId": "SystemService_GetSchema",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1GetSchemaResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "tags": [
          "SystemService"
        ]
      }
    },
    "/v1/system/status": {
      "get": {
        "summary": "GetStatus 返回控制面服务状态。",
        "operationId": "SystemService_GetStatus",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1GetStatusResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "tags": [
          "SystemService"
        ]
      }
    },
    "/v1/system/version": {
      "get": {
        "summary": "GetVersion 返回控制面构建信息。",
        "operationId": "SystemService_GetVersion",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1GetVersionResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "tags": [
          "SystemService"
        ]
      }
    }
  },
  "definitions": {
    "SystemServiceRestartComponentBody": {
      "type": "object"
    },
    "v1ComponentHealth": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "title": "name 是 Provider 名（\"swarm\"、\"traefik\"、\"victorialogs\"…）。"
        },
        "capability": {
          "type": "string",
          "title": "capability 是端口种类（runtime/proxy/registry/logging/metrics/objectstore）。"
        },
        "healthy": {
          "type": "boolean"
        },
        "details": {
          "type": "string",
          "title": "details 是降级矩阵口径的人读说明（用户可见文本英文）。"
        }
      }
    },
    "v1ExplainResponse": {
      "type": "object",
      "properties": {
        "entry": {
          "$ref": "#/definitions/v1SchemaEntry"
        }
      }
    },
    "v1GetSchemaResponse": {
      "type": "object",
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1SchemaEntry"
          },
          "title": "entries 按名字典序（输出确定性是 golden 钉扎的前提）。"
        }
      }
    },
    "v1GetStatusResponse": {
      "type": "object",
      "properties": {
        "state": {
          "$ref": "#/definitions/v1StatusState"
        },
        "version": {
          "type": "string"
        },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1ComponentHealth"
          },
          "title": "components 是进程内在册 Provider 实例的逐项健康（IA v3 二期③：\nManaged Providers 排障面数据源——架构 §8 降级矩阵驱动；聚合态 =\n任一不健康即 DEGRADED，检查超时按不健康计）。"
        }
      }
    },
    "v1GetVersionResponse": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        },
        "date": {
          "type": "string"
        }
      }
    },
    "v1ListPlatformBackupsResponse": {
      "type": "object",
      "properties": {
        "snapshots": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1PlatformSnapshot"
          }
        }
      }
    },
    "v1PlatformSnapshot": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "title": "restic 短 id"
        },
        "time": {
          "type": "string",
          "title": "RFC3339"
        },
        "hostname": {
          "type": "string",
          "title": "快照主机名（控制面节点）"
        }
      },
      "title": "PlatformSnapshot 是本地仓快照行投影（restic snapshots 直读面）。"
    },
    "v1RestartComponentResponse": {
      "type": "object",
      "properties": {
        "restarted": {
          "type": "integer",
          "format": "int32",
          "title": "restarted 是实际强制重排的载体数（受管组件通常 = 1）。"
        }
      }
    },
    "v1SchemaEntry": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "title": "name 是 explain 的寻址名：spec 用领域名词（app/task/database），\nevent 用事件名（deployment.succeeded）。"
        },
        "kind": {
          "type": "string",
          "title": "kind 是条目家族：spec | event。"
        },
        "summary": {
          "type": "string",
          "title": "summary 是一句英文摘要（事件面单源自 eventcode 注册表）。"
        },
        "schema_json": {
          "type": "string",
          "title": "schema_json 是 JSON Schema（draft-07 子集）的 canonical 紧凑 JSON\n文本；字段名 snake_case，与 CLI --json（protojson UseProtoNames）同\n一拼写面。"
        }
      },
      "title": "SchemaEntry 是一条可解释资源的自描述（寻址名/家族/摘要/契约体）。"
    },
    "v1StatusState": {
      "type": "string",
      "enum": [
        "STATUS_STATE_UNSPECIFIED",
        "STATUS_STATE_HEALTHY",
        "STATUS_STATE_DEGRADED"
      ],
      "default": "STATUS_STATE_UNSPECIFIED"
    },
    "v1TriggerPlatformBackupRequest": {
      "type": "object"
    },
    "v1TriggerPlatformBackupResponse": {
      "type": "object",
      "properties": {
        "snapshot": {
          "$ref": "#/definitions/v1PlatformSnapshot"
        }
      },
      "title": "TriggerPlatformBackupResponse 携带本次执行后本地仓最新快照（整体成败\n由 RPC 错误面承载；失败仓/外置仓细节进 platform.backup_failed 事件）。"
    }
  }
}

{
  "swagger": "2.0",
  "info": {
    "title": "Runtime 上下文（领域模型 §2）：集群观测与节点运维面（Node/Enrollment）。",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "NodesService"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/v1/nodes": {
      "get": {
        "operationId": "NodesService_ListNodes",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListNodesResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "after_node_id",
            "description": "after_node_id 游标（上一页末条 platform_id；空 = 首页）。nodes 是\n观测缓存表（非权威），无 ULID 主键——游标轴 = platform_id 字典序\n升序（既有响应序不变；ADR-0026 after_* + limit 惯例）。",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          }
        ],
        "tags": [
          "NodesService"
        ]
      }
    },
    "/v1/nodes/enroll": {
      "post": {
        "summary": "EnrollNode 输出工作节点加入材料（F0.20：节点零平台安装物）。活 join\ntoken 等价集群成员权（不可逆），档位是 platform:admin（C3 收紧：\nnodes:admin 只覆盖可逆运维面，不得白送集群钥匙）；rotate 先轮换\n全部 join token（泄漏处置）再返回新材料。",
        "operationId": "NodesService_EnrollNode",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1EnrollNodeResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1EnrollNodeRequest"
            }
          }
        ],
        "tags": [
          "NodesService"
        ]
      }
    },
    "/v1/nodes/{node_id}/cordon": {
      "post": {
        "operationId": "NodesService_CordonNode",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1CordonNodeResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "node_id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/NodesServiceCordonNodeBody"
            }
          }
        ],
        "tags": [
          "NodesService"
        ]
      }
    },
    "/v1/nodes/{node_id}/drain": {
      "post": {
        "summary": "节点运维三动词（F0.19 RuntimeAdmin 面）：平台节点 ID 为锚；可逆的\n调度控制走 nodes write 档。",
        "operationId": "NodesService_DrainNode",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1DrainNodeResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "node_id",
            "description": "node_id 是平台节点 ID（永不复用）。",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/NodesServiceDrainNodeBody"
            }
          }
        ],
        "tags": [
          "NodesService"
        ]
      }
    },
    "/v1/nodes/{node_id}/uncordon": {
      "post": {
        "operationId": "NodesService_UncordonNode",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1UncordonNodeResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "node_id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/NodesServiceUncordonNodeBody"
            }
          }
        ],
        "tags": [
          "NodesService"
        ]
      }
    }
  },
  "definitions": {
    "NodesServiceCordonNodeBody": {
      "type": "object"
    },
    "NodesServiceDrainNodeBody": {
      "type": "object",
      "title": "节点运维动词以平台节点 ID 为锚（响应无数据面：结果即动作本身）。"
    },
    "NodesServiceUncordonNodeBody": {
      "type": "object"
    },
    "v1CordonNodeResponse": {
      "type": "object"
    },
    "v1DrainNodeResponse": {
      "type": "object"
    },
    "v1EnrollNodeRequest": {
      "type": "object",
      "properties": {
        "rotate": {
          "type": "boolean",
          "title": "rotate 先轮换全部 join token（worker+manager；泄漏处置：旧材料即刻\n失效）再返回新材料。"
        }
      }
    },
    "v1EnrollNodeResponse": {
      "type": "object",
      "properties": {
        "join_command": {
          "type": "string",
          "title": "join_command 是工作节点完整加入命令（swarm join 形态）。"
        },
        "agent_command": {
          "type": "string",
          "title": "agent_command 是节点中继代理装载脚本（ADR-0049：busybox 载体 +\n/v1/platform/binary 下载 fleetlyd + docker cp 注入 + docker.sock 挂载\n跑 `fleetlyd relay`；幂等——重跑即代理升级/修复通道）。join 语义不变：\n只跑 join_command 的节点集群面完整，exec 面不可用（relay_online=false\n诚实可见）。"
        }
      }
    },
    "v1ListNodesResponse": {
      "type": "object",
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1Node"
          }
        }
      }
    },
    "v1Node": {
      "type": "object",
      "properties": {
        "platform_id": {
          "type": "string"
        },
        "carrier_id": {
          "type": "string"
        },
        "hostname": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "available": {
          "type": "boolean"
        },
        "first_seen_at": {
          "type": "string"
        },
        "last_seen_at": {
          "type": "string"
        },
        "relay_online": {
          "type": "boolean",
          "title": "relay_online 是节点中继代理在连状态（活体观测——exec 会话的路由前提，\nADR-0049；false = 该节点不可 exec，重跑 enroll 的 agent 脚本恢复）。"
        },
        "relay_agent_version": {
          "type": "string",
          "title": "relay_agent_version 是在连代理上报的平台版本（滞后代理照常受理——帧\n协议只增；升级后重跑 agent 脚本即刷新）。"
        }
      },
      "title": "Node 是观测缓存行（非权威；节点 ID 永不复用）。"
    },
    "v1UncordonNodeResponse": {
      "type": "object"
    }
  }
}

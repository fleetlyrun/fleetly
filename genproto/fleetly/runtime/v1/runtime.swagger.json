{
  "swagger": "2.0",
  "info": {
    "title": "Runtime 上下文（领域模型 §2）：集群观测与节点运维面（Node/Enrollment）。",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "NodesService"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/v1/nodes": {
      "get": {
        "operationId": "NodesService_ListNodes",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListNodesResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "tags": [
          "NodesService"
        ]
      }
    },
    "/v1/nodes/enroll": {
      "post": {
        "summary": "EnrollNode 输出工作节点加入材料（F0.20：节点零平台安装物）。",
        "operationId": "NodesService_EnrollNode",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1EnrollNodeResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1EnrollNodeRequest"
            }
          }
        ],
        "tags": [
          "NodesService"
        ]
      }
    },
    "/v1/nodes/{node_id}/cordon": {
      "post": {
        "operationId": "NodesService_CordonNode",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1CordonNodeResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "node_id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/NodesServiceCordonNodeBody"
            }
          }
        ],
        "tags": [
          "NodesService"
        ]
      }
    },
    "/v1/nodes/{node_id}/drain": {
      "post": {
        "summary": "节点运维三动词（F0.19 RuntimeAdmin 面）：平台节点 ID 为锚；可逆的\n调度控制走 nodes write 档（加入材料敏感，EnrollNode 保持 admin 档）。",
        "operationId": "NodesService_DrainNode",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1DrainNodeResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "node_id",
            "description": "node_id 是平台节点 ID（永不复用）。",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/NodesServiceDrainNodeBody"
            }
          }
        ],
        "tags": [
          "NodesService"
        ]
      }
    },
    "/v1/nodes/{node_id}/uncordon": {
      "post": {
        "operationId": "NodesService_UncordonNode",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1UncordonNodeResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "node_id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/NodesServiceUncordonNodeBody"
            }
          }
        ],
        "tags": [
          "NodesService"
        ]
      }
    }
  },
  "definitions": {
    "NodesServiceCordonNodeBody": {
      "type": "object"
    },
    "NodesServiceDrainNodeBody": {
      "type": "object",
      "title": "节点运维动词以平台节点 ID 为锚（响应无数据面：结果即动作本身）。"
    },
    "NodesServiceUncordonNodeBody": {
      "type": "object"
    },
    "v1CordonNodeResponse": {
      "type": "object"
    },
    "v1DrainNodeResponse": {
      "type": "object"
    },
    "v1EnrollNodeRequest": {
      "type": "object"
    },
    "v1EnrollNodeResponse": {
      "type": "object",
      "properties": {
        "join_command": {
          "type": "string",
          "title": "join_command 是工作节点完整加入命令（swarm join 形态）。"
        }
      }
    },
    "v1ListNodesResponse": {
      "type": "object",
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1Node"
          }
        }
      }
    },
    "v1Node": {
      "type": "object",
      "properties": {
        "platform_id": {
          "type": "string"
        },
        "carrier_id": {
          "type": "string"
        },
        "hostname": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "available": {
          "type": "boolean"
        },
        "first_seen_at": {
          "type": "string"
        },
        "last_seen_at": {
          "type": "string"
        }
      },
      "title": "Node 是观测缓存行（非权威；节点 ID 永不复用）。"
    },
    "v1UncordonNodeResponse": {
      "type": "object"
    }
  }
}

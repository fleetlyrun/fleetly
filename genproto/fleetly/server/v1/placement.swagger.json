{
  "swagger": "2.0",
  "info": {
    "title": "fleetly/server/v1/placement.proto",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "PlacementService"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/v1/apps/{app}/placement": {
      "get": {
        "operationId": "PlacementService_ShowPlacement",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ShowPlacementResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "app",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "PlacementService"
        ]
      }
    }
  },
  "definitions": {
    "v1ErrorResponse": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "title": "稳定错误码字符串（如 \"E_COMPOSE_INVALID\"），注册表校验只增。"
        },
        "message": {
          "type": "string",
          "title": "人读错误信息（面向运维/集成方，不承诺文案稳定）。"
        },
        "stage": {
          "type": "string",
          "title": "失败所处管线阶段（如 resolve / build / deploy / serve；勿与部署子状态\nphase 混用——该字段 2026-09-20 命名审查由 phase 更名 stage）。"
        },
        "deployment_id": {
          "type": "string",
          "title": "关联的部署 ID（无关联时为空）。"
        },
        "suggestion": {
          "type": "string",
          "title": "可执行的修复建议（面向用户展示）。"
        },
        "context": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "title": "结构化附加上下文（machine-readable 键值对）。"
        },
        "docs": {
          "type": "string",
          "title": "相关文档 URL（错误码文档锚点）。"
        }
      },
      "title": "ErrorResponse 是 fleetly 对外错误信封的唯一契约定义（发布专项 §2.7、\n架构 D21）：gateway HTTPErrorHandler（阶段 3 落地）将 gRPC 错误统一渲染\n为本结构，snake_case JSON 输出；code 与 T0.2 错误码注册表（唯一真源，\n只增不复用）对齐。"
    },
    "v1PlacementView": {
      "type": "object",
      "properties": {
        "platform_node_id": {
          "type": "string"
        },
        "label_ref": {
          "type": "string",
          "title": "用户 label 书写原值（显示名或 n_\u003cULID\u003e；空 = 未声明）。"
        },
        "state": {
          "type": "string"
        },
        "reason": {
          "type": "string",
          "title": "进入当前状态的派生原因（node_down / node_gone 等；可空）。"
        },
        "source": {
          "type": "string",
          "title": "绑定来源（placement 源词表：显式/自动钉住等）。"
        },
        "pinned_at": {
          "type": "string",
          "format": "date-time"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "title": "PlacementView 是 placements 行投影（state ∈ bound/blocked/unresolved，\n派生语义见 state-model §2.10；blocked/unresolved 是 app 派生状态\nblocked 的来源）。"
    },
    "v1ShowPlacementResponse": {
      "type": "object",
      "properties": {
        "app": {
          "type": "string"
        },
        "placement": {
          "$ref": "#/definitions/v1PlacementView",
          "title": "未绑定时 placement 不输出（EmitUnpopulated=false 语义）。"
        },
        "volumes": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1VolumeView"
          },
          "title": "卷注册表（无卷应用为空集）。"
        }
      }
    },
    "v1VolumeView": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "platform_node_id": {
          "type": "string",
          "title": "平台节点 ID（与 PlacementView.platform_node_id 同词族）。"
        },
        "mount_path": {
          "type": "string"
        },
        "status": {
          "type": "string"
        }
      },
      "title": "VolumeView 是卷注册表行投影（volumes 表；orphaned 状态位经 status 透出\n——删除应用保留卷）。"
    }
  }
}

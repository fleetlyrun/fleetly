{
  "swagger": "2.0",
  "info": {
    "title": "fleetly/server/v1/logs.proto",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "LogsService"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/v1/apps/{app}/logs": {
      "get": {
        "operationId": "LogsService_ListHistoryLogs",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListHistoryLogsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "app",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "service",
            "description": "compose 服务名；空 = 全部服务。",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "since",
            "description": "时间窗下界；缺省 = 保留窗起点。",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "date-time"
          },
          {
            "name": "until",
            "description": "时间窗上界；缺省 = 现在。",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "date-time"
          },
          {
            "name": "limit",
            "description": "返回上限（缺省 200，天花板 1000；超过取最新 limit 条）。",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "source",
            "description": "来源过滤：container | build；空 = 全部。",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "LogsService"
        ]
      }
    },
    "/v1/apps/{app}/logs/stream": {
      "get": {
        "operationId": "LogsService_FollowLogs",
        "responses": {
          "200": {
            "description": "A successful response.(streaming responses)",
            "schema": {
              "type": "object",
              "properties": {
                "result": {
                  "$ref": "#/definitions/v1FollowLogsResponse"
                }
              },
              "title": "Stream result of v1FollowLogsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "app",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "service",
            "description": "compose 服务名；空 = 该 app 全部服务。",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "LogsService"
        ]
      }
    }
  },
  "definitions": {
    "v1ErrorResponse": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "title": "稳定错误码字符串（如 \"E_COMPOSE_INVALID\"），注册表校验只增。"
        },
        "message": {
          "type": "string",
          "title": "人读错误信息（面向运维/集成方，不承诺文案稳定）。"
        },
        "stage": {
          "type": "string",
          "title": "失败所处管线阶段（如 resolve / build / deploy / serve；勿与部署子状态\nphase 混用——该字段 2026-09-20 命名审查由 phase 更名 stage）。"
        },
        "deployment_id": {
          "type": "string",
          "title": "关联的部署 ID（无关联时为空）。"
        },
        "suggestion": {
          "type": "string",
          "title": "可执行的修复建议（面向用户展示）。"
        },
        "context": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "title": "结构化附加上下文（machine-readable 键值对）。"
        },
        "docs": {
          "type": "string",
          "title": "相关文档 URL（错误码文档锚点）。"
        }
      },
      "title": "ErrorResponse 是 fleetly 对外错误信封的唯一契约定义（发布专项 §2.7、\n架构 D21）：gateway HTTPErrorHandler（阶段 3 落地）将 gRPC 错误统一渲染\n为本结构，snake_case JSON 输出；code 与 T0.2 错误码注册表（唯一真源，\n只增不复用）对齐。"
    },
    "v1FollowLogsResponse": {
      "type": "object",
      "properties": {
        "entry": {
          "$ref": "#/definitions/v1LogEntryView"
        }
      }
    },
    "v1ListHistoryLogsResponse": {
      "type": "object",
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1LogEntryView"
          }
        }
      }
    },
    "v1LogEntryView": {
      "type": "object",
      "properties": {
        "app": {
          "type": "string"
        },
        "service": {
          "type": "string"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "stderr": {
          "type": "boolean"
        },
        "line": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      },
      "title": "LogEntryView 是单条日志投影。source ∈ container | build。"
    }
  }
}

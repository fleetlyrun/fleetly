{
  "swagger": "2.0",
  "info": {
    "title": "fleetly/server/v1/secrets.proto",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "SecretsService"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/v1/apps/{app}/secrets": {
      "get": {
        "summary": "ListSecrets 该 app 全部 secret（按 name 字典序；只投影名称/指纹/时间锚\n——值与密文零出现）。",
        "operationId": "SecretsService_ListSecrets",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListSecretsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "app",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "SecretsService"
        ]
      },
      "post": {
        "summary": "SetSecret 写入（覆盖即轮换）：值经 age envelope 加密落 app_secrets；\n审计 secret.set（diff 只带名称与 hash8 指纹——值零出现）。",
        "operationId": "SecretsService_SetSecret",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1SetSecretResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "app",
            "description": "归属 app 名。",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/SecretsServiceSetSecretBody"
            }
          }
        ],
        "tags": [
          "SecretsService"
        ]
      }
    },
    "/v1/apps/{app}/secrets/{name}": {
      "delete": {
        "summary": "RemoveSecret 删除单条（幂等不做：不存在 404；审计 secret.removed）。\n已被运行中服务引用的 removal 不追写部署——引用方下次部署 preflight\nE_SECRET_NOT_FOUND 诚实失败（移除声明再部署的既有语义）。",
        "operationId": "SecretsService_RemoveSecret",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1RemoveSecretResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "app",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "name",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "SecretsService"
        ]
      }
    }
  },
  "definitions": {
    "SecretsServiceSetSecretBody": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "title": "secret 声明名（compose 服务级 secrets 引用的短名；合法 /run/secrets/\u003cname\u003e\n文件名字符集 ^[A-Za-z0-9][A-Za-z0-9._-]*$——与 internal/compose 的\nsecret 名校验同规则，注释锚互指）。"
        },
        "value": {
          "type": "string",
          "title": "值（明文；age 加密在服务端。上限 64KiB sanity——Swarm secret 单对象\n上界 500KB 的宽松内档；长度进形状层即拒，不落日志）。"
        }
      }
    },
    "v1ErrorResponse": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "title": "稳定错误码字符串（如 \"E_COMPOSE_INVALID\"），注册表校验只增。"
        },
        "message": {
          "type": "string",
          "title": "人读错误信息（面向运维/集成方，不承诺文案稳定）。"
        },
        "stage": {
          "type": "string",
          "title": "失败所处管线阶段（如 resolve / build / deploy / serve；勿与部署子状态\nphase 混用——该字段 2026-09-20 命名审查由 phase 更名 stage）。"
        },
        "deployment_id": {
          "type": "string",
          "title": "关联的部署 ID（无关联时为空）。"
        },
        "suggestion": {
          "type": "string",
          "title": "可执行的修复建议（面向用户展示）。"
        },
        "context": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "title": "结构化附加上下文（machine-readable 键值对）。"
        },
        "docs": {
          "type": "string",
          "title": "相关文档 URL（错误码文档锚点）。"
        }
      },
      "title": "ErrorResponse 是 fleetly 对外错误信封的唯一契约定义（发布专项 §2.7、\n架构 D21）：gateway HTTPErrorHandler（阶段 3 落地）将 gRPC 错误统一渲染\n为本结构，snake_case JSON 输出；code 与 T0.2 错误码注册表（唯一真源，\n只增不复用）对齐。"
    },
    "v1ListSecretsResponse": {
      "type": "object",
      "properties": {
        "secrets": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1SecretView"
          }
        }
      }
    },
    "v1RemoveSecretResponse": {
      "type": "object",
      "properties": {
        "app": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "v1SecretView": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "hash8": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "title": "SecretView 是平台密钥库条目的只读投影（值/密文/明文零出现——D-DB-7\n无值读回；hash8 是唯一的值比对面）。"
    },
    "v1SetSecretResponse": {
      "type": "object",
      "properties": {
        "app": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "hash8": {
          "type": "string",
          "title": "值指纹（sha256 前 8 hex——「是不是那个值」比对面；值材料零出现）。"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}

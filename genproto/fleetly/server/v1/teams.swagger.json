          }
        }
      }
    },
    "v1RemoveTeamMemberResponse": {
      "type": "object"
    },
    "v1RevokeInviteResponse": {
      "type": "object"
    },
    "v1SetTeamMemberRoleResponse": {
      "type": "object",
      "properties": {
        "member": {
          "$ref": "#/definitions/v1TeamMemberView"
        }
      }
    },
    "v1TeamMemberView": {
      "type": "object",
      "properties": {
        "team_id": {
          "type": "string"
        },
        "user_id": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "title": "团队角色（owner/admin/developer/viewer 四档，设计 §3.2）。"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "email": {
          "type": "string",
          "title": "属主投影（成员列表的可用性面——email 与显示名；无敏感材料）。"
        },
        "display_name": {
          "type": "string"
        }
      }
    },
    "v1TeamView": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "slug": {
          "type": "string",
          "title": "单词制标识（[a-z0-9]{2,32}、全局唯一、不可变；底座命名公式段）。"
        },
        "name": {
          "type": "string",
          "title": "人读显示名。"
        },
        "created_by": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "title": "TeamView 是团队行的无敏感投影。"
    },
    "v1UpdateTeamResponse": {
      "type": "object",
      "properties": {
        "team": {
          "$ref": "#/definitions/v1TeamView"
        }
      }
    }
  }
}

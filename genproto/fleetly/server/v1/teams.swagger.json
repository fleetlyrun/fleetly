        },
        "parameters": [
          {
            "name": "team_id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "TeamsService"
        ]
      },
      "post": {
        "summary": "CreateInvite owner/admin 可邀（§3.1）：所邀角色不得高于邀请者自身；\n邀 owner 角色 = owner 专属。明文 token 仅本次响应一次性返回（无 SMTP：\n邀请链接页面直出供复制）。",
        "operationId": "TeamsService_CreateInvite",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1CreateInviteResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "team_id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/TeamsServiceCreateInviteBody"
            }
          }
        ],
        "tags": [
          "TeamsService"
        ]
      }
    },
    "/v1/teams/{team_id}/invites/{invite_id}:revoke": {
      "post": {
        "summary": "RevokeInvite 吊销未消费邀请（已消费/已吊销按幂等成功）。",
        "operationId": "TeamsService_RevokeInvite",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1RevokeInviteResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "team_id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "invite_id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/TeamsServiceRevokeInviteBody"
            }
          }
        ],
        "tags": [
          "TeamsService"
        ]
      }
    },
    "/v1/teams/{team_id}/members": {
      "get": {
        "operationId": "TeamsService_ListTeamMembers",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListTeamMembersResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "team_id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "TeamsService"
        ]
      }
    },
    "/v1/teams/{team_id}/members/{user_id}": {
      "delete": {
        "summary": "RemoveTeamMember owner 专属：移出成员（联动清该团队全部项目覆写行，\nD-W0-2；最后一名 owner → E_TEAM_LAST_OWNER）。",
        "operationId": "TeamsService_RemoveTeamMember",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1RemoveTeamMemberResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "team_id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "user_id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "TeamsService"
        ]
      }
    },
    "/v1/teams/{team_id}/members:set-role": {
      "post": {
        "summary": "SetTeamMemberRole owner 专属：调整成员角色（最后一名 owner 降级 →\nE_TEAM_LAST_OWNER）。",
        "operationId": "TeamsService_SetTeamMemberRole",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1SetTeamMemberRoleResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "team_id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/TeamsServiceSetTeamMemberRoleBody"
            }
          }
        ],
        "tags": [
          "TeamsService"
        ]
      }
    }
  },
  "definitions": {
    "TeamsServiceCreateInviteBody": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string"
        },
        "role": {
          "type": "string"
        }
      }
    },
    "TeamsServiceRevokeInviteBody": {
      "type": "object"
    },
    "TeamsServiceSetTeamMemberRoleBody": {
      "type": "object",
      "properties": {
        "user_id": {
          "type": "string"
        },
        "role": {
          "type": "string"
        }
      }
    },
    "TeamsServiceUpdateTeamBody": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "title": "新显示名（slug 不可变——请求无 slug 字段，改 slug 只能重建团队）。"
        }
      }
    },
    "v1CreateInviteResponse": {
      "type": "object",
      "properties": {
        "invite": {
          "$ref": "#/definitions/v1InviteView"
        },
        "token": {
          "type": "string",
          "title": "明文一次性 token（sha256 入库）：仅本次响应可见，用于拼邀请链接\nconsole/auth/invite?token=…（无 SMTP 直出供复制，设计 §3.1）。"
        }
      }
    },
    "v1CreateTeamRequest": {
      "type": "object",
      "properties": {
        "slug": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "v1CreateTeamResponse": {
      "type": "object",
      "properties": {
        "team": {
          "$ref": "#/definitions/v1TeamView"
        }
      }
    },
    "v1DeleteTeamResponse": {
      "type": "object"
    },
    "v1ErrorResponse": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "title": "稳定错误码字符串（如 \"E_COMPOSE_INVALID\"），注册表校验只增。"
        },
        "message": {
          "type": "string",
          "title": "人读错误信息（面向运维/集成方，不承诺文案稳定）。"
        },
        "stage": {
          "type": "string",
          "title": "失败所处管线阶段（如 resolve / build / deploy / serve；勿与部署子状态\nphase 混用——该字段 2026-09-20 命名审查由 phase 更名 stage）。"
        },
        "deployment_id": {
          "type": "string",
          "title": "关联的部署 ID（无关联时为空）。"
        },
        "suggestion": {
          "type": "string",
          "title": "可执行的修复建议（面向用户展示）。"
        },
        "context": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "title": "结构化附加上下文（machine-readable 键值对）。"
        },
        "docs": {
          "type": "string",
          "title": "相关文档 URL（错误码文档锚点）。"
        }
      },
      "title": "ErrorResponse 是 fleetly 对外错误信封的唯一契约定义（发布专项 §2.7、\n架构 D21）：gateway HTTPErrorHandler（阶段 3 落地）将 gRPC 错误统一渲染\n为本结构，snake_case JSON 输出；code 与 T0.2 错误码注册表（唯一真源，\n只增不复用）对齐。"
    },
    "v1GetTeamResponse": {
      "type": "object",
      "properties": {
        "team": {
          "$ref": "#/definitions/v1TeamView"
        }
      }
    },
    "v1InviteView": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "team_id": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "title": "被邀邮箱（小写归一）。"
        },
        "role": {
          "type": "string"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "title": "过期时刻（创建 + 7 天；一次性窗口）。"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "accepted_at": {
          "type": "string",
          "format": "date-time",
          "title": "已接受/已吊销时输出对应时刻；未消费时不输出。"
        },
        "revoked_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "v1ListTeamInvitesResponse": {
      "type": "object",
      "properties": {
        "invites": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1InviteView"
          }
        }
      }
    },
    "v1ListTeamMembersResponse": {
      "type": "object",
      "properties": {
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1TeamMemberView"
          }
        }
      }
    },
    "v1ListTeamsResponse": {
      "type": "object",
      "properties": {

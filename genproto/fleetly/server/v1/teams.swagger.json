  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/v1/teams": {
      "get": {
        "summary": "ListTeams 我所在团队；平台管理员 = 全部（§3.2 只读全域）。",
        "operationId": "TeamsService_ListTeams",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListTeamsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "tags": [
          "TeamsService"
        ]
      },
      "post": {
        "summary": "CreateTeam 建队：调用方成为 owner（§3.1）；slug 冲突 409、保留字\n422（E_TEAM_SLUG_RESERVED）。",
        "operationId": "TeamsService_CreateTeam",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1CreateTeamResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1CreateTeamRequest"
            }
          }
        ],
        "tags": [
          "TeamsService"
        ]
      }
    },
    "/v1/teams/{id}": {
      "get": {
        "operationId": "TeamsService_GetTeam",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1GetTeamResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "TeamsService"
        ]
      },
      "delete": {
        "summary": "DeleteTeam owner 专属两段式（confirm = slug）+ 项目须空（资源先迁走\n或删光，不做隐式级联，§3.1）。",
        "operationId": "TeamsService_DeleteTeam",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1DeleteTeamResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "confirm",
            "description": "两段式确认：confirm 必须等于团队 slug（数据/归属安全同 DeleteDatabase\n口径）。",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "TeamsService"
        ]
      },
      "patch": {
        "summary": "UpdateTeam 仅改显示名（slug 不可变——请求无 slug 字段）。",
        "operationId": "TeamsService_UpdateTeam",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1UpdateTeamResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/TeamsServiceUpdateTeamBody"
            }
          }
        ],
        "tags": [
          "TeamsService"
        ]
      }
    },
    "/v1/teams/{team_id}/invites": {
      "get": {
        "operationId": "TeamsService_ListTeamInvites",
        "responses": {
          "200": {
            "description": "A successful response.",

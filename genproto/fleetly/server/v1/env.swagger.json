{
  "swagger": "2.0",
  "info": {
    "title": "fleetly/server/v1/env.proto",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "EnvService"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/v1/apps/{app}/env": {
      "get": {
        "operationId": "EnvService_ListEnv",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListEnvResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "app",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "EnvService"
        ]
      }
    },
    "/v1/apps/{app}/env/{key}": {
      "get": {
        "operationId": "EnvService_GetEnv",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1GetEnvResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "app",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "key",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "EnvService"
        ]
      },
      "delete": {
        "operationId": "EnvService_RemoveEnv",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1RemoveEnvResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "app",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "key",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "EnvService"
        ]
      },
      "put": {
        "operationId": "EnvService_SetEnv",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1SetEnvResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "app",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "key",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/EnvServiceSetEnvBody"
            }
          }
        ],
        "tags": [
          "EnvService"
        ]
      }
    }
  },
  "definitions": {
    "EnvServiceSetEnvBody": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string",
          "title": "明文入参；服务端 envelope 加密落库（值不进审计/事件/日志）。"
        }
      }
    },
    "v1EnvVarView": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "title": "platform | system。"
        },
        "status": {
          "type": "string",
          "title": "pending | effective。"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "title": "EnvVarView 是 env 行的无值投影（值恒脱敏——读值走 GetEnv 显式路径）。"
    },
    "v1ErrorResponse": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "title": "稳定错误码字符串（如 \"E_COMPOSE_INVALID\"），注册表校验只增。"
        },
        "message": {
          "type": "string",
          "title": "人读错误信息（面向运维/集成方，不承诺文案稳定）。"
        },
        "phase": {
          "type": "string",
          "title": "失败所处发布阶段（如 resolve / build / deploy / serve）。"
        },
        "deployment_id": {
          "type": "string",
          "title": "关联的部署 ID（无关联时为空）。"
        },
        "suggestion": {
          "type": "string",
          "title": "可执行的修复建议（面向用户展示）。"
        },
        "context": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "title": "结构化附加上下文（machine-readable 键值对）。"
        },
        "docs": {
          "type": "string",
          "title": "相关文档 URL（错误码文档锚点）。"
        }
      },
      "title": "ErrorResponse 是 fleetly 对外错误信封的唯一契约定义（发布专项 §2.7、\n架构 D21）：gateway HTTPErrorHandler（阶段 3 落地）将 gRPC 错误统一渲染\n为本结构，snake_case JSON 输出；code 与 T0.2 错误码注册表（唯一真源，\n只增不复用）对齐。"
    },
    "v1GetEnvResponse": {
      "type": "object",
      "properties": {
        "app": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "value": {
          "type": "string",
          "title": "明文（admin scope 专用路径）。"
        },
        "status": {
          "type": "string",
          "title": "pending | effective。"
        }
      }
    },
    "v1ListEnvResponse": {
      "type": "object",
      "properties": {
        "env_vars": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1EnvVarView"
          }
        }
      }
    },
    "v1RemoveEnvResponse": {
      "type": "object",
      "properties": {
        "app": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "title": "平台层台账立即删行；运行实例的 env 快照随下次部署更新（与 pending\n同链路语义，取值恒 \"pending\"——移除不是即时生效面）。"
        }
      }
    },
    "v1SetEnvResponse": {
      "type": "object",
      "properties": {
        "app": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "title": "恒 \"pending\"（随下次部署生效）。"
        }
      }
    }
  }
}

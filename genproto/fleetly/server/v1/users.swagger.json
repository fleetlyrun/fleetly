    "v1CreateUserRequest": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string"
        },
        "display_name": {
          "type": "string",
          "title": "人读显示名（空 = 缺省取 email 本地部分，state 层落定）。"
        }
      }
    },
    "v1CreateUserResponse": {
      "type": "object",
      "properties": {
        "user": {
          "$ref": "#/definitions/v1UserView"
        },
        "temporary_password": {
          "type": "string",
          "title": "明文临时口令，仅本次响应可见；首次登录后建议由用户自行修改（改口令\n自助面挂账设计 §12——v0.3 找回口令 = 平台管理员重置）。"
        }
      }
    },
    "v1DisableUserResponse": {
      "type": "object",
      "properties": {
        "user": {
          "$ref": "#/definitions/v1UserView"
        }
      }
    },
    "v1EnableUserResponse": {
      "type": "object",
      "properties": {
        "user": {
          "$ref": "#/definitions/v1UserView"
        }
      }
    },
    "v1ErrorResponse": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "title": "稳定错误码字符串（如 \"E_COMPOSE_INVALID\"），注册表校验只增。"
        },
        "message": {
          "type": "string",
          "title": "人读错误信息（面向运维/集成方，不承诺文案稳定）。"
        },
        "stage": {
          "type": "string",
          "title": "失败所处管线阶段（如 resolve / build / deploy / serve；勿与部署子状态\nphase 混用——该字段 2026-09-20 命名审查由 phase 更名 stage）。"
        },
        "deployment_id": {
          "type": "string",
          "title": "关联的部署 ID（无关联时为空）。"
        },
        "suggestion": {
          "type": "string",
          "title": "可执行的修复建议（面向用户展示）。"
        },
        "context": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "title": "结构化附加上下文（machine-readable 键值对）。"
        },
        "docs": {
          "type": "string",
          "title": "相关文档 URL（错误码文档锚点）。"
        }
      },
      "title": "ErrorResponse 是 fleetly 对外错误信封的唯一契约定义（发布专项 §2.7、\n架构 D21）：gateway HTTPErrorHandler（阶段 3 落地）将 gRPC 错误统一渲染\n为本结构，snake_case JSON 输出；code 与 T0.2 错误码注册表（唯一真源，\n只增不复用）对齐。"
    },
    "v1GetAuditRetentionResponse": {
      "type": "object",
      "properties": {
        "days": {
          "type": "integer",
          "format": "int32",
          "title": "显式设置的留存天数（set=false 时不输出）。"
        },
        "set": {
          "type": "boolean",
          "title": "该键是否被显式保存过（false = platform_settings 无行）。"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "title": "设置行 updated_at（未设置时不输出）。"
        }
      },
      "title": "GetAuditRetentionResponse 是审计留存设置的只读投影（v0.3 W3-S3，rbac-teams\n§6 D-W0-6 收口——写面随本 RPC 族补齐，state 层 LoadAuditSettings W3-S1 已\n备）。本层只诚实投影「未设置 / 显式设置」之别：set=false 时 days 不输出，\n生效值回落链（config state.audit_retention_days \u003e 缺省 90）由消费方裁决\n——Console 显示缺省口径，不谎报设置存在。"
    },
    "v1GrantPlatformAdminResponse": {
      "type": "object",
      "properties": {
        "user": {
          "$ref": "#/definitions/v1UserView"
        }
      }
    },
    "v1ListUsersResponse": {
      "type": "object",
      "properties": {
        "users": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1UserView"
          }
        }
      }
    },
    "v1ResetUserPasswordResponse": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "temporary_password": {
          "type": "string",
          "title": "明文临时口令，仅本次响应可见；旧口令立即失效，且该用户全部会话同\n事务吊销（重置即全端下线，设计 §2.1 本票裁决）。"
        }
      }
    },
    "v1RevokePlatformAdminResponse": {
      "type": "object",
      "properties": {
        "user": {
          "$ref": "#/definitions/v1UserView"
        }
      }
    },
    "v1SetAuditRetentionRequest": {
      "type": "object",
      "properties": {
        "days": {
          "type": "integer",
          "format": "int32",
          "title": "留存天数，≥1（buf.validate 与 state.ValidateRetentionDays 同值域双门\n——0/负数会把「关掉清理」伪装成合法设置，两层都显式拒绝）。"
        }
      }
    },
    "v1SetAuditRetentionResponse": {
      "type": "object",
      "properties": {
        "days": {
          "type": "integer",
          "format": "int32"
        }
      }
    },
    "v1SetRegistrationRequest": {
      "type": "object",
      "properties": {
        "open": {
          "type": "boolean",
          "title": "true = 开放自助注册；false = 关闭（平台管理员仍可经 CreateUser 加人）。"
        }
      }
    },
    "v1SetRegistrationResponse": {
      "type": "object",
      "properties": {
        "open": {
          "type": "boolean"
        }
      }
    },
    "v1UserView": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "is_platform_admin": {
          "type": "boolean",
          "title": "平台管理员标志（用户标志非角色，设计 §3.2）。"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "disabled_at": {
          "type": "string",
          "format": "date-time",
          "title": "已禁用时输出禁用时刻；在册时不输出。"
        }
      },
      "title": "UserView 是用户行的无敏感投影：口令哈希不存在于任何通道（state 层投影\n纪律）；disabled_at 为空 = 在册。"
    }
  }
}

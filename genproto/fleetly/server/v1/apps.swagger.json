{
  "swagger": "2.0",
  "info": {
    "title": "fleetly/server/v1/apps.proto",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "AppsService"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/v1/apps": {
      "get": {
        "operationId": "AppsService_ListApps",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListAppsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "limit",
            "description": "列表上限（缺省 100；v0.1 单机规模不做分页游标）。",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "project",
            "description": "项目收窄（v0.3 W2-S4 可见性过滤，rbac-teams §4.2）：裸名或 `team/project`\n限定形（D-W0-9 解析规则；解析域 = 调用方可见项目集，机具令牌/平台管理\n员 = 全库）。空 = 不收窄（用户面仍按可见项目集过滤）。",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "AppsService"
        ]
      }
    },
    "/v1/apps/{name}": {
      "get": {
        "operationId": "AppsService_GetApp",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1GetAppResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "name",
            "description": "应用名（compose 应用名，权威态唯一键）。",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "AppsService"
        ]
      },
      "delete": {
        "operationId": "AppsService_DeleteApp",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1DeleteAppResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "AppsService"
        ]
      }
    },
    "/v1/apps/{name}/source": {
      "put": {
        "summary": "SetAppSource 设置 webhook 拉源配置（remote url + 分支 + 认证形态；\nadmin）。source_branch 同时是 git push 的触发分支（app 配置分支，\n默认 main）。\n认证材料（https_token/ssh_key）经平台 envelope 加密落库，引用不落明文。",
        "operationId": "AppsService_SetAppSource",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1SetAppSourceResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/AppsServiceSetAppSourceBody"
            }
          }
        ],
        "tags": [
          "AppsService"
        ]
      }
    },
    "/v1/apps/{name}/webhook": {
      "get": {
        "summary": "ShowAppWebhook 回读 webhook/git 触发配置（无敏感投影：secret 只回\nconfigured 位；admin scope——source URL 与分支拓扑属运维面）。",
        "operationId": "AppsService_ShowAppWebhook",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ShowAppWebhookResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "AppsService"
        ]
      }
    },
    "/v1/apps/{name}/webhook-secret": {
      "put": {
        "summary": "SetAppWebhookSecret 设置 per-app webhook 签名密钥（T2.19；admin）。\n值经平台 envelope 加密落库（明文不落），show 面只回 configured 位。\n未配置 = webhook 端点未启用（404 语义）。",
        "operationId": "AppsService_SetAppWebhookSecret",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1SetAppWebhookSecretResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "name",
            "description": "应用名。",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/AppsServiceSetAppWebhookSecretBody"
            }
          }
        ],
        "tags": [
          "AppsService"
        ]
      }
    }
  },
  "definitions": {
    "AppsServiceSetAppSourceBody": {
      "type": "object",
      "properties": {
        "source_url": {
          "type": "string",
          "title": "拉源 remote URL（file:// 与 https://、ssh:// 形态）。"
        },
        "source_branch": {
          "type": "string",
          "title": "app 配置分支（默认 main）：push 触发与 webhook 拉取共用此分支。"
        },
        "source_auth_kind": {
          "type": "string",
          "title": "认证形态：none | https_token | ssh_key。"
        },
        "source_auth_secret": {
          "type": "string",
          "title": "认证材料（https_token = token 原文；ssh_key = PEM 私钥）。source_auth_kind =\nnone 时必须为空；服务端 envelope 加密落库，明文不落、永不回读。\nprotovalidate 形状约束在服务端用例层按 source_auth_kind 交叉校验（跨字段\n规则—— CEL 交叉字段此处不引入，保持 proto 面最小）。"
        }
      }
    },
    "AppsServiceSetAppWebhookSecretBody": {
      "type": "object",
      "properties": {
        "secret": {
          "type": "string",
          "title": "webhook 签名密钥（HMAC-SHA256 原料，GitHub/Gitea 同形态）。≥16 字符\n——弱密钥显式拒绝（验签是该端点的唯一认证）。"
        }
      }
    },
    "v1AppView": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "lifecycle": {
          "type": "string",
          "title": "生命周期状态位：active / deleting / deleted。"
        },
        "derived_state": {
          "type": "string",
          "title": "派生状态：running / degraded / blocked / down（读面即时推导）。"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "v1DeleteAppResponse": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "lifecycle": {
          "type": "string",
          "title": "删除推进后的生命周期位（active → deleting）。"
        }
      }
    },
    "v1DeploymentView": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "app": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "title": "deploy | rollback。"
        },
        "status": {
          "type": "string"
        },
        "phase": {
          "type": "string",
          "title": "子状态（blocked_waiting 或空）。"
        },
        "revision_id": {
          "type": "string"
        },
        "error_code": {
          "type": "string"
        },
        "verdict": {
          "type": "string"
        },
        "recovery": {
          "type": "string",
          "title": "同记录恢复记录（replay | blocked；空 = 无）。"
        },
        "substrate_halted": {
          "type": "boolean",
          "title": "首发失败 scale=0 保留现场。"
        },
        "first_healthy_at": {
          "type": "string",
          "format": "date-time"
        },
        "downtime_ms": {
          "type": "string",
          "format": "int64"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_git_sha": {
          "type": "string",
          "title": "git 触发来源（T2.19）：仅经 git push(SSH)/webhook 入队（DeployFromGit\n路径）的部署非空——sha 为 40 位 commit、ref 为 refs/heads/\u003cbranch\u003e；\nAPI/CLI 直传 compose 的部署为空（EmitUnpopulated=false 语义下不输出）。\nwebhook 入口的 (app, sha) 幂等去重即以此字段为判据，读面回显供\nAI-Agent/运营核对「这次部署来自哪个 commit」。"
        },
        "source_git_ref": {
          "type": "string"
        }
      },
      "title": "DeploymentView 是部署状态机行的只读投影（词表与 state 层一致：\nqueued/preparing/building/releasing/observing/succeeded/failed/cancelled）。"
    },
    "v1ErrorResponse": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "title": "稳定错误码字符串（如 \"E_COMPOSE_INVALID\"），注册表校验只增。"
        },
        "message": {
          "type": "string",
          "title": "人读错误信息（面向运维/集成方，不承诺文案稳定）。"
        },
        "stage": {
          "type": "string",
          "title": "失败所处管线阶段（如 resolve / build / deploy / serve；勿与部署子状态\nphase 混用——该字段 2026-09-20 命名审查由 phase 更名 stage）。"
        },
        "deployment_id": {
          "type": "string",
          "title": "关联的部署 ID（无关联时为空）。"
        },
        "suggestion": {
          "type": "string",
          "title": "可执行的修复建议（面向用户展示）。"
        },
        "context": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "title": "结构化附加上下文（machine-readable 键值对）。"
        },
        "docs": {
          "type": "string",
          "title": "相关文档 URL（错误码文档锚点）。"
        }
      },
      "title": "ErrorResponse 是 fleetly 对外错误信封的唯一契约定义（发布专项 §2.7、\n架构 D21）：gateway HTTPErrorHandler（阶段 3 落地）将 gRPC 错误统一渲染\n为本结构，snake_case JSON 输出；code 与 T0.2 错误码注册表（唯一真源，\n只增不复用）对齐。"
    },
    "v1GetAppResponse": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "lifecycle": {
          "type": "string"
        },
        "derived_state": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "placement": {
          "$ref": "#/definitions/v1PlacementView",
          "title": "放置绑定（未绑定时不输出——EmitUnpopulated=false 语义下 message 零值\n字段不渲染，读面缺省即「无绑定」）。"
        },
        "recent_deployments": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1DeploymentView"
          },
          "title": "最近部署（created_at 倒序，至多 5 条；派生状态的正交细节）。"
        }
      }
    },
    "v1ListAppsResponse": {
      "type": "object",
      "properties": {
        "apps": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1AppView"
          }
        }
      }
    },
    "v1PlacementView": {
      "type": "object",
      "properties": {
        "platform_node_id": {
          "type": "string"
        },
        "label_ref": {
          "type": "string",
          "title": "用户 label 书写原值（显示名或 n_\u003cULID\u003e；空 = 未声明）。"
        },
        "state": {
          "type": "string"
        },
        "reason": {
          "type": "string",
          "title": "进入当前状态的派生原因（node_down / node_gone 等；可空）。"
        },
        "source": {
          "type": "string",
          "title": "绑定来源（placement 源词表：显式/自动钉住等）。"
        },
        "pinned_at": {
          "type": "string",
          "format": "date-time"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "title": "PlacementView 是 placements 行投影（state ∈ bound/blocked/unresolved，\n派生语义见 state-model §2.10；blocked/unresolved 是 app 派生状态\nblocked 的来源）。"
    },
    "v1SetAppSourceResponse": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "source_url": {
          "type": "string"
        },
        "source_branch": {
          "type": "string"
        },
        "source_auth_kind": {
          "type": "string"
        }
      }
    },
    "v1SetAppWebhookSecretResponse": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "configured": {
          "type": "boolean",
          "title": "恒 true（设置成功即已配置）。"
        }
      }
    },
    "v1ShowAppWebhookResponse": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "secret_configured": {
          "type": "boolean",
          "title": "webhook 签名密钥已配置（secret 值永不回读）。"
        },
        "source_url": {
          "type": "string",
          "title": "拉源配置（未设置时 url/branch 为空串、auth_kind = none）。"
        },
        "source_branch": {
          "type": "string",
          "title": "app 配置分支（默认 main）：push 触发与 webhook 拉取共用此分支。"
        },
        "source_auth_kind": {
          "type": "string",
          "title": "none | https_token | ssh_key。"
        },
        "git_remote_hint": {
          "type": "string",
          "title": "push/webhook 端点提示（SSH git URL，如 ssh://git@host:8424/\u003capp\u003e.git；\n主机位取 control-plane 可达地址的尽力形态）。"
        }
      }
    }
  }
}

{
  "swagger": "2.0",
  "info": {
    "title": "fleetly/server/v1/system.proto",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "SystemService"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/v1/system/backups": {
      "get": {
        "summary": "ListBackups 状态备份台账（T2.22，只读）：热备快照的诚实账（kind/路径/\r\nsha256/verify_status）。verify_status=failed 的行是红色告警面的一部分\r\n——台账如实保留失败行，消费方据此判断备份可用性。",
        "operationId": "SystemService_ListBackups",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListBackupsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "tags": [
          "SystemService"
        ]
      },
      "post": {
        "summary": "TriggerBackup 手动触发一次状态备份（T2.22；deploy scope——写面语义，\r\n与升级编排 pre_upgrade 快照共用同一同步入口；响应即落账后的台账行，\r\nverify_status=failed 时调用方必须视为备份失败而非请求失败歧义态）。",
        "operationId": "SystemService_TriggerBackup",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1TriggerBackupResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1TriggerBackupRequest"
            }
          }
        ],
        "tags": [
          "SystemService"
        ]
      }
    },
    "/v1/system/ingress": {
      "get": {
        "operationId": "SystemService_GetIngressStatus",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1GetIngressStatusResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "tags": [
          "SystemService"
        ]
      }
    },
    "/v1/system/nodes": {
      "get": {
        "operationId": "SystemService_ListNodes",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListNodesResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "tags": [
          "SystemService"
        ]
      }
    },
    "/v1/system/ping": {
      "get": {
        "operationId": "SystemService_Ping",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1PingResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "tags": [
          "SystemService"
        ]
      }
    },
    "/v1/system/status": {
      "get": {
        "operationId": "SystemService_GetSystemStatus",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1GetSystemStatusResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "tags": [
          "SystemService"
        ]
      }
    }
  },
  "definitions": {
    "v1BackupHealth": {
      "type": "object",
      "properties": {
        "last_backup_id": {
          "type": "string",
          "title": "最近一次备份的台账 ID（= 备份目录名）。"
        },
        "last_kind": {
          "type": "string",
          "title": "最近一次备份的触发类别（daily/pre_upgrade/post_deploy/manual）。"
        },
        "last_backup_at": {
          "type": "string",
          "format": "date-time",
          "title": "最近一次备份的台账落账时刻。"
        },
        "last_verify_status": {
          "type": "string",
          "title": "回读校验结论（verified/failed）。"
        },
        "last_error": {
          "type": "string",
          "title": "失败原因原文（verified 行为空）。"
        }
      },
      "title": "BackupHealth 是系统状态里备份面的明细视图（组件布尔健康的展开：最近\r\n一次备份的时间与校验结论——「绿色成功但实际没备份」的对立面是让\r\nverify_status 与时间直接可见）。"
    },
    "v1BackupView": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "title": "触发类别：daily / pre_upgrade / post_deploy / manual（历史行可为\r\nhot/cold）。"
        },
        "path": {
          "type": "string",
          "title": "快照文件路径。"
        },
        "sha256": {
          "type": "string",
          "title": "快照文件 sha256（hex；回读校验对象）。"
        },
        "size_bytes": {
          "type": "string",
          "format": "int64"
        },
        "verify_status": {
          "type": "string",
          "title": "回读校验结论：verified / failed（失败行保留——红色告警面的一部分）。"
        },
        "error": {
          "type": "string",
          "title": "校验失败原因原文（verified 行为空）。"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "title": "台账落账时刻。"
        }
      },
      "title": "BackupView 是状态备份台账行的只读投影（state_backups 表）。path 指向\r\n备份目录内的快照文件；manifest.json 与其同目录（含 sha256/密钥指纹/\r\nschema 版本——恢复核对材料，密钥本体绝不入备份目录）。"
    },
    "v1CertLedgerView": {
      "type": "object",
      "properties": {
        "app": {
          "type": "string"
        },
        "domain": {
          "type": "string"
        },
        "cert_sha256": {
          "type": "string"
        },
        "cert_not_after": {
          "type": "string",
          "format": "date-time"
        }
      },
      "title": "CertLedgerView 是证书台账行投影（domains 表 cert 列对照；app 为显示名，\r\n已删除应用回退显示 app id）。"
    },
    "v1ComponentHealth": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "ok": {
          "type": "boolean"
        },
        "error": {
          "type": "string"
        }
      },
      "title": "ComponentHealth 是单组件健康如实上报（name = lynx 服务名，如\r\nstate.store / state.observer / ingress.traefik）。ok=false 时 error 为\r\n检查器返回原文。"
    },
    "v1ErrorResponse": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "title": "稳定错误码字符串（如 \"E_COMPOSE_INVALID\"），注册表校验只增。"
        },
        "message": {
          "type": "string",
          "title": "人读错误信息（面向运维/集成方，不承诺文案稳定）。"
        },
        "phase": {
          "type": "string",
          "title": "失败所处发布阶段（如 resolve / build / deploy / serve）。"
        },
        "deployment_id": {
          "type": "string",
          "title": "关联的部署 ID（无关联时为空）。"
        },
        "suggestion": {
          "type": "string",
          "title": "可执行的修复建议（面向用户展示）。"
        },
        "context": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "title": "结构化附加上下文（machine-readable 键值对）。"
        },
        "docs": {
          "type": "string",
          "title": "相关文档 URL（错误码文档锚点）。"
        }
      },
      "title": "ErrorResponse 是 fleetly 对外错误信封的唯一契约定义（发布专项 §2.7、\n架构 D21）：gateway HTTPErrorHandler（阶段 3 落地）将 gRPC 错误统一渲染\n为本结构，snake_case JSON 输出；code 与 T0.2 错误码注册表（唯一真源，\n只增不复用）对齐。"
    },
    "v1GetIngressStatusResponse": {
      "type": "object",
      "properties": {
        "traefik": {
          "$ref": "#/definitions/v1TraefikView"
        },
        "config_addr": {
          "type": "string",
          "title": "控制面配置端点监听地址（ingress.config_addr 配置原值）。"
        },
        "advertise_ip": {
          "type": "string",
          "title": "下发给 Traefik 的控制面可达 IP（空 = 自动探测）。"
        },
        "responder": {
          "type": "string",
          "title": "ACME challenge 应答器基址（空 = 未接入集中签发）。"
        },
        "healthz": {
          "type": "string",
          "title": "配置端点两面探测结果（服务端环回执行）：/healthz 无鉴权状态行；\r\n/configs 带 token 鉴权核验（401 = token 缺失/错误，如实报告；200 =\r\n鉴权通过且返回合法 JSON）。不可达 = \"unreachable\"。"
        },
        "auth": {
          "type": "string"
        },
        "certificates": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1CertLedgerView"
          },
          "title": "证书台账（有证书的域名行）。"
        },
        "cert_dir": {
          "type": "string",
          "title": "证书存储目录（控制面侧）与其中的 app 清单（meta 索引；目录缺失 =\r\n空清单非错误，cert_dir_error 承载读取故障原文）。"
        },
        "cert_dir_apps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cert_dir_error": {
          "type": "string"
        }
      }
    },
    "v1GetSystemStatusResponse": {
      "type": "object",
      "properties": {
        "service": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1ComponentHealth"
          }
        },
        "backup": {
          "$ref": "#/definitions/v1BackupHealth",
          "title": "状态备份健康视图（T2.22）：最近一次台账行的投影。从未备份 → 不输出\r\n（backup 组件的 ComponentHealth 行会以 ok=false 显式表达不健康）。"
        }
      }
    },
    "v1ListBackupsResponse": {
      "type": "object",
      "properties": {
        "backups": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1BackupView"
          }
        }
      }
    },
    "v1ListNodesResponse": {
      "type": "object",
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1NodeView"
          }
        }
      }
    },
    "v1NodeView": {
      "type": "object",
      "properties": {
        "swarm_node_id": {
          "type": "string"
        },
        "platform_id": {
          "type": "string",
          "title": "平台节点 ID（fleetly.placement.node-id label；未锚定时为空）。"
        },
        "hostname": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "availability": {
          "type": "string"
        },
        "is_manager": {
          "type": "boolean"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "stale": {
          "type": "boolean"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "title": "NodeView 是节点观测缓存行的只读投影（state-model §2.2：缓存禁止用于\r\n决策，展示/诊断专用；节点变更用 docker node 原生命令）。观测数据带\r\nobserved_at/stale——状态诚实契约（architecture §4.2 横切硬指标）；\r\nnodes 不提供「最后心跳」字段。"
    },
    "v1PingResponse": {
      "type": "object",
      "properties": {
        "service": {
          "type": "string",
          "title": "应答服务名（恒 \"fleetlyd\"）。"
        },
        "version": {
          "type": "string",
          "title": "服务版本（构建 -ldflags 注入，未注入时为 \"dev\"）。"
        }
      }
    },
    "v1TraefikView": {
      "type": "object",
      "properties": {
        "exists": {
          "type": "boolean"
        },
        "image": {
          "type": "string"
        },
        "static_args": {
          "type": "integer",
          "format": "int32"
        },
        "error": {
          "type": "string"
        }
      },
      "title": "TraefikView 是入口服务实况投影（Swarm service inspect；不可达时 exists\r\n= false 且 error 为探测原文）。"
    },
    "v1TriggerBackupRequest": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "title": "触发类别（缺省 manual；升级编排传 pre_upgrade）。manual/daily/\r\npre_upgrade/post_deploy 之外取值被请求校验拒绝。"
        }
      }
    },
    "v1TriggerBackupResponse": {
      "type": "object",
      "properties": {
        "backup": {
          "$ref": "#/definitions/v1BackupView"
        }
      }
    }
  }
}

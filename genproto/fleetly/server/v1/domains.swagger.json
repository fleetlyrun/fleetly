{
  "swagger": "2.0",
  "info": {
    "title": "fleetly/server/v1/domains.proto",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "DomainsService"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/v1/apps/{app}/domains": {
      "get": {
        "operationId": "DomainsService_ListAppDomains",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListAppDomainsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "app",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "DomainsService"
        ]
      },
      "post": {
        "summary": "CreateAppDomain 新建域名资源（host 全局独占：冲突 409 E_DOMAIN_CONFLICT；\n每服务 ≤5、每 app ≤10 超限 4xx E_DOMAIN_UNSUPPORTED）。写入成功后同步\n触发入口收敛（路由发布 + 证书保障；失败以事件/审计披露，资源行保留）。",
        "operationId": "DomainsService_CreateAppDomain",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1CreateAppDomainResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "app",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/DomainsServiceCreateAppDomainBody"
            }
          }
        ],
        "tags": [
          "DomainsService"
        ]
      }
    },
    "/v1/apps/{app}/domains/verify": {
      "post": {
        "operationId": "DomainsService_VerifyAppDomains",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1VerifyAppDomainsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "app",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/DomainsServiceVerifyAppDomainsBody"
            }
          }
        ],
        "tags": [
          "DomainsService"
        ]
      }
    },
    "/v1/apps/{app}/domains/{domain}": {
      "delete": {
        "summary": "RemoveAppDomain 删除域名行（幂等不做：不存在 404）。删除即触发入口\n收敛（路由撤销；证书 SAN 集变化随下次签发收敛）。",
        "operationId": "DomainsService_RemoveAppDomain",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1RemoveAppDomainResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "app",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "domain",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "DomainsService"
        ]
      },
      "put": {
        "summary": "UpdateAppDomain 更新既有域名行（{domain} 是寻址键 = host，不改名——\n改名 = 删除 + 重建，与 env key 同口径）。空字段 = 保持现值（CLI 局部\n更新形态；Console 恒发全量）。",
        "operationId": "DomainsService_UpdateAppDomain",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1UpdateAppDomainResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "app",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "domain",
            "description": "寻址键（host，不改名）。",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/DomainsServiceUpdateAppDomainBody"
            }
          }
        ],
        "tags": [
          "DomainsService"
        ]
      }
    }
  },
  "definitions": {
    "DomainsServiceCreateAppDomainBody": {
      "type": "object",
      "properties": {
        "domain": {
          "type": "string",
          "title": "host（入参原文；服务端归一化：trim/小写/IDN→punycode；通配主机本票\n拒绝——app 级 DNS-01 签发链沿 W5）。"
        },
        "service": {
          "type": "string",
          "title": "compose 服务名（存在性由部署期底座事实兜底：服务未运行 → 502 诚实\n暴露，不在此层猜服务清单）。"
        },
        "port": {
          "type": "string"
        },
        "protocol": {
          "type": "string",
          "title": "http | h2c（空 = http）。"
        },
        "cert_mode": {
          "type": "string",
          "title": "http01 | wildcard（空 = http01）。"
        }
      }
    },
    "DomainsServiceUpdateAppDomainBody": {
      "type": "object",
      "properties": {
        "service": {
          "type": "string",
          "title": "空 = 保持现值（全空 = 无操作更新，幂等返回当前行）。"
        },
        "port": {
          "type": "string"
        },
        "protocol": {
          "type": "string"
        },
        "cert_mode": {
          "type": "string"
        }
      }
    },
    "DomainsServiceVerifyAppDomainsBody": {
      "type": "object"
    },
    "v1CreateAppDomainResponse": {
      "type": "object",
      "properties": {
        "domain": {
          "$ref": "#/definitions/v1DomainView"
        }
      }
    },
    "v1DomainCheckView": {
      "type": "object",
      "properties": {
        "domain": {
          "type": "string"
        },
        "ips": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resolved": {
          "type": "boolean"
        },
        "http_80": {
          "type": "string",
          "title": "80 端口探测结果（空 = 不可达；否则记录响应状态行）。"
        },
        "https_443": {
          "type": "string",
          "title": "443 端口 TLS 握手结果（空 = 不可达）。"
        },
        "cert_subject": {
          "type": "string",
          "title": "实收证书的诚实记录（不经信任判定）。"
        },
        "cert_dns_names": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cert_not_after": {
          "type": "string",
          "format": "date-time"
        },
        "error": {
          "type": "string",
          "title": "单域名探测失败原文（resolve 失败等）。"
        }
      }
    },
    "v1DomainView": {
      "type": "object",
      "properties": {
        "service": {
          "type": "string"
        },
        "domain": {
          "type": "string"
        },
        "port": {
          "type": "string",
          "title": "路由目标端口（'' = 未同步）。"
        },
        "cert_sha256": {
          "type": "string",
          "title": "证书 PEM 内容 sha256 hex；'' = 尚无证书。"
        },
        "cert_not_after": {
          "type": "string",
          "format": "date-time",
          "title": "叶证书 NotAfter；未签发时不输出。"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "protocol": {
          "type": "string",
          "title": "后端协议（http | h2c；h2c = Traefik 后端 scheme=h2c 直出）。"
        },
        "cert_mode": {
          "type": "string",
          "title": "证书模式（http01 | wildcard；wildcard 的 DNS-01 app 级签发链沿 W5）。"
        }
      }
    },
    "v1ErrorResponse": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "title": "稳定错误码字符串（如 \"E_COMPOSE_INVALID\"），注册表校验只增。"
        },
        "message": {
          "type": "string",
          "title": "人读错误信息（面向运维/集成方，不承诺文案稳定）。"
        },
        "stage": {
          "type": "string",
          "title": "失败所处管线阶段（如 resolve / build / deploy / serve；勿与部署子状态\nphase 混用——该字段 2026-09-20 命名审查由 phase 更名 stage）。"
        },
        "deployment_id": {
          "type": "string",
          "title": "关联的部署 ID（无关联时为空）。"
        },
        "suggestion": {
          "type": "string",
          "title": "可执行的修复建议（面向用户展示）。"
        },
        "context": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "title": "结构化附加上下文（machine-readable 键值对）。"
        },
        "docs": {
          "type": "string",
          "title": "相关文档 URL（错误码文档锚点）。"
        }
      },
      "title": "ErrorResponse 是 fleetly 对外错误信封的唯一契约定义（发布专项 §2.7、\n架构 D21）：gateway HTTPErrorHandler（阶段 3 落地）将 gRPC 错误统一渲染\n为本结构，snake_case JSON 输出；code 与 T0.2 错误码注册表（唯一真源，\n只增不复用）对齐。"
    },
    "v1ListAppDomainsResponse": {
      "type": "object",
      "properties": {
        "domains": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1DomainView"
          }
        }
      }
    },
    "v1RemoveAppDomainResponse": {
      "type": "object",
      "properties": {
        "app": {
          "type": "string"
        },
        "domain": {
          "type": "string"
        }
      }
    },
    "v1UpdateAppDomainResponse": {
      "type": "object",
      "properties": {
        "domain": {
          "$ref": "#/definitions/v1DomainView"
        }
      }
    },
    "v1VerifyAppDomainsResponse": {
      "type": "object",
      "properties": {
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1DomainCheckView"
          }
        }
      }
    }
  }
}

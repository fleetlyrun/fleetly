{
  "swagger": "2.0",
  "info": {
    "title": "Telemetry 上下文（领域模型 §2）：Event 流与日志查询面（日志/指标采集\n侧由 Logging/Metrics Capability 承载，本面是查询入口）。",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "EventsService"
    },
    {
      "name": "LogsService"
    },
    {
      "name": "MetricsService"
    },
    {
      "name": "AlertingService"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/v1/alerts": {
      "get": {
        "summary": "ListAlertStates 是现行告警状态面（含系统内置规则行）。",
        "operationId": "AlertingService_ListAlertStates",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListAlertStatesResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "tags": [
          "AlertingService"
        ]
      }
    },
    "/v1/alerts/rules": {
      "get": {
        "operationId": "AlertingService_ListAlertRules",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListAlertRulesResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "app_id",
            "description": "app_id 过滤（空 = 全部）。",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "AlertingService"
        ]
      },
      "post": {
        "summary": "CreateAlertRule 登记一条 per-App 阈值规则（评估在采集遍内原生完成）。",
        "operationId": "AlertingService_CreateAlertRule",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1CreateAlertRuleResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1CreateAlertRuleRequest"
            }
          }
        ],
        "tags": [
          "AlertingService"
        ]
      }
    },
    "/v1/alerts/rules/{rule_id}": {
      "delete": {
        "operationId": "AlertingService_DeleteAlertRule",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1DeleteAlertRuleResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "rule_id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "AlertingService"
        ]
      }
    },
    "/v1/channels": {
      "get": {
        "operationId": "AlertingService_ListNotificationChannels",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListNotificationChannelsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "tags": [
          "AlertingService"
        ]
      },
      "post": {
        "summary": "CreateNotificationChannel 登记一条通知通道（webhook/telegram；配置\nage 信封入库——URL/token 只写不读）。",
        "operationId": "AlertingService_CreateNotificationChannel",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1CreateNotificationChannelResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1CreateNotificationChannelRequest"
            }
          }
        ],
        "tags": [
          "AlertingService"
        ]
      }
    },
    "/v1/channels/{channel_id}": {
      "delete": {
        "operationId": "AlertingService_DeleteNotificationChannel",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1DeleteNotificationChannelResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "channel_id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "AlertingService"
        ]
      }
    },
    "/v1/channels/{channel_id}/test": {
      "post": {
        "summary": "TestNotificationChannel 即时发一条测试载荷（通道验收锚；配置错误\n原样上抛）。",
        "operationId": "AlertingService_TestNotificationChannel",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1TestNotificationChannelResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "channel_id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/AlertingServiceTestNotificationChannelBody"
            }
          }
        ],
        "tags": [
          "AlertingService"
        ]
      }
    },
    "/v1/events": {
      "get": {
        "operationId": "EventsService_ListEvents",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListEventsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "after_seq",
            "description": "after_seq 是游标（返回 seq 之后的事件，升序）。",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "int64"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          }
        ],
        "tags": [
          "EventsService"
        ]
      }
    },
    "/v1/events/status": {
      "get": {
        "summary": "GetEventStatus 是断档判定与快照重同步的基准面：earliest_seq 定保留窗\n起点（after_seq \u003c earliest 即断档），last_seq 定重同步后的新游标。",
        "operationId": "EventsService_GetEventStatus",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1GetEventStatusResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "tags": [
          "EventsService"
        ]
      }
    },
    "/v1/events/stream": {
      "get": {
        "summary": "StreamEvents 是订阅面（gRPC server-streaming；Console/Agent 的等待原语\n数据源）。follow=false 只重放保留窗随后收流；follow=true 持续跟随直至\n客户端取消。after_seq 落在保留窗外 → E_EVENTS_GONE（410，重同步）。",
        "operationId": "EventsService_StreamEvents",
        "responses": {
          "200": {
            "description": "A successful response.(streaming responses)",
            "schema": {
              "type": "object",
              "properties": {
                "result": {
                  "$ref": "#/definitions/v1StreamEventsResponse"
                }
              },
              "title": "Stream result of v1StreamEventsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "after_seq",
            "description": "after_seq 是游标（0 = 从保留窗最早开始；落在保留窗外 → 410）。",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "int64"
          },
          {
            "name": "follow",
            "description": "follow 持续跟随新事件（直至取消）；false = 重放保留窗后收流。",
            "in": "query",
            "required": false,
            "type": "boolean"
          }
        ],
        "tags": [
          "EventsService"
        ]
      }
    },
    "/v1/events/ticket": {
      "post": {
        "summary": "IssueEventTicket 为 SSE 订阅路径换一次性短时票据（ADR-0026：浏览器\nEventSource 不能设自定义头——Bearer 换秒级 TTL 单用途票据，SSE 以\nquery 参数携带；限订阅路径，泄漏面受控）。",
        "operationId": "EventsService_IssueEventTicket",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1IssueEventTicketResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1IssueEventTicketRequest"
            }
          }
        ],
        "tags": [
          "EventsService"
        ]
      }
    },
    "/v1/logs": {
      "get": {
        "operationId": "LogsService_StreamLogs",
        "responses": {
          "200": {
            "description": "A successful response.(streaming responses)",
            "schema": {
              "type": "object",
              "properties": {
                "result": {
                  "$ref": "#/definitions/v1StreamLogsResponse"
                }
              },
              "title": "Stream result of v1StreamLogsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "app_id",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "process",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "tail_lines",
            "description": "tail_lines 尾部行数（0 = 全量最近缓冲）；follow 持续跟随。",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "int64"
          },
          {
            "name": "follow",
            "in": "query",
            "required": false,
            "type": "boolean"
          },
          {
            "name": "since",
            "description": "since/until 是时间窗（RFC3339；空 = 不限）。实时路径（无 text）窗口\n作用于最近缓冲；text 检索路径窗口作用于保留窗（ADR-0040 双径）。",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "until",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "text",
            "description": "text 是文本过滤（ADR-0040 检索路径）：非空时经持久化日志存储全保留窗\n匹配；与 follow 组合 = 实时尾随检索（≥5s 批汇延迟）。",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "LogsService"
        ]
      }
    },
    "/v1/metrics": {
      "get": {
        "operationId": "MetricsService_QueryMetrics",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1QueryMetricsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "query",
            "description": "query 是 PromQL（透传；App 域过滤经 container_label_fleetly_ns_*\n序列标签——CLI/Console 侧构造）。",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "start",
            "description": "start/end 是时间窗（RFC3339；空 end = 现在，空 start = end 前 1h）。",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "end",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "step_seconds",
            "description": "step_seconds 是采样步长（0 = 缺省 15s）。",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "int64"
          }
        ],
        "tags": [
          "MetricsService"
        ]
      }
    }
  },
  "definitions": {
    "AlertingServiceTestNotificationChannelBody": {
      "type": "object"
    },
    "v1AlertRule": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "app_id": {
          "type": "string"
        },
        "metric": {
          "type": "string",
          "title": "metric: cpu_percent | memory_working_set_bytes（值域冻结）。"
        },
        "threshold": {
          "type": "number",
          "format": "double"
        },
        "for_seconds": {
          "type": "string",
          "format": "int64",
          "title": "for_seconds 是持续窗（连续越限 ≥ 本值才迁移 firing；0 = 立即；\n采样近似语义见 ADR-0041）。"
        },
        "enabled": {
          "type": "boolean"
        },
        "state": {
          "type": "string",
          "title": "state: ok | firing（现行评估态）。"
        },
        "state_since": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        }
      }
    },
    "v1AlertState": {
      "type": "object",
      "properties": {
        "rule_id": {
          "type": "string"
        },
        "app_id": {
          "type": "string"
        },
        "metric": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "state_since": {
          "type": "string"
        },
        "observed_value": {
          "type": "number",
          "format": "double",
          "title": "observed_value 是最近一次评估值（firing 判定依据；NaN = 无样本）。"
        },
        "system": {
          "type": "boolean",
          "title": "system 标记内置规则行（platform-offsite-backup；不可删）。"
        }
      }
    },
    "v1CreateAlertRuleRequest": {
      "type": "object",
      "properties": {
        "app_id": {
          "type": "string"
        },
        "metric": {
          "type": "string"
        },
        "threshold": {
          "type": "number",
          "format": "double"
        },
        "for_seconds": {
          "type": "string",
          "format": "int64"
        }
      }
    },
    "v1CreateAlertRuleResponse": {
      "type": "object",
      "properties": {
        "rule": {
          "$ref": "#/definitions/v1AlertRule"
        }
      }
    },
    "v1CreateNotificationChannelRequest": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "title": "name 是通道名（全局唯一；人类引用锚）。"
        },
        "kind": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "title": "webhook 形态：url 是接收端点（可含凭证查询串——age 信封入库）。"
        },
        "bot_token": {
          "type": "string",
          "title": "telegram 形态：bot_token 与 chat_id（age 信封入库）。"
        },
        "chat_id": {
          "type": "string"
        }
      }
    },
    "v1CreateNotificationChannelResponse": {
      "type": "object",
      "properties": {
        "channel": {
          "$ref": "#/definitions/v1NotificationChannel"
        }
      }
    },
    "v1DeleteAlertRuleResponse": {
      "type": "object"
    },
    "v1DeleteNotificationChannelResponse": {
      "type": "object"
    },
    "v1Event": {
      "type": "object",
      "properties": {
        "seq": {
          "type": "string",
          "format": "int64"
        },
        "name": {
          "type": "string"
        },
        "aggregate": {
          "type": "string"
        },
        "aggregate_id": {
          "type": "string"
        },
        "payload": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        }
      },
      "title": "Event 是 Outbox 行形态（单调 seq；payload 是 JSON 字节文本）。"
    },
    "v1GetEventStatusResponse": {
      "type": "object",
      "properties": {
        "earliest_seq": {
          "type": "string",
          "format": "int64",
          "title": "earliest_seq 是保留窗内最早事件 seq（断档判定锚：0 = 空表/全在窗内）。"
        },
        "last_seq": {
          "type": "string",
          "format": "int64",
          "title": "last_seq 是当前最大 seq（快照重同步基准：重读列表后以它为新游标）。"
        }
      }
    },
    "v1IssueEventTicketRequest": {
      "type": "object"
    },
    "v1IssueEventTicketResponse": {
      "type": "object",
      "properties": {
        "ticket": {
          "type": "string",
          "title": "ticket 是一次性短时票据（秒级 TTL、单用途、限 SSE 订阅路径）。"
        },
        "expires_in": {
          "type": "integer",
          "format": "int32",
          "title": "expires_in 是票据存活秒数。"
        }
      }
    },
    "v1ListAlertRulesResponse": {
      "type": "object",
      "properties": {
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1AlertRule"
          }
        }
      }
    },
    "v1ListAlertStatesResponse": {
      "type": "object",
      "properties": {
        "states": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1AlertState"
          }
        }
      }
    },
    "v1ListEventsResponse": {
      "type": "object",
      "properties": {
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1Event"
          }
        },
        "last_seq": {
          "type": "string",
          "format": "int64"
        }
      }
    },
    "v1ListNotificationChannelsResponse": {
      "type": "object",
      "properties": {
        "channels": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1NotificationChannel"
          }
        }
      }
    },
    "v1MetricPoint": {
      "type": "object",
      "properties": {
        "time": {
          "type": "string"
        },
        "value": {
          "type": "number",
          "format": "double"
        }
      }
    },
    "v1MetricSeries": {
      "type": "object",
      "properties": {
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "points": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1MetricPoint"
          }
        }
      }
    },
    "v1NotificationChannel": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "title": "kind: webhook | telegram（值域见 CONTEXT.md Notification Channel 词条）。"
        },
        "enabled": {
          "type": "boolean"
        },
        "last_failure": {
          "type": "string",
          "title": "last_failure 是最近一次派发失败摘要（空 = 无失败/未派发过；配置载荷\n永不回显——只回 id/name/kind 形态，凭证单向）。"
        },
        "created_at": {
          "type": "string"
        }
      }
    },
    "v1QueryMetricsResponse": {
      "type": "object",
      "properties": {
        "series": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1MetricSeries"
          }
        }
      }
    },
    "v1StreamEventsResponse": {
      "type": "object",
      "properties": {
        "event": {
          "$ref": "#/definitions/v1Event",
          "title": "event 是本帧事件（与 ListEvents 同一 Event 形态）。"
        }
      }
    },
    "v1StreamLogsResponse": {
      "type": "object",
      "properties": {
        "workload_id": {
          "type": "string"
        },
        "container": {
          "type": "string"
        },
        "node": {
          "type": "string"
        },
        "time": {
          "type": "string"
        },
        "line": {
          "type": "string",
          "format": "byte"
        }
      },
      "title": "StreamLogsResponse 一帧日志（workload 标注归属；时间 RFC3339；container\n是载体归因标识——swarm 形态为 task ID，ADR-0040）。"
    },
    "v1TestNotificationChannelResponse": {
      "type": "object",
      "properties": {
        "delivered": {
          "type": "boolean",
          "title": "delivered 是送达回执（false + error 文本 = 配置/网络面失败）。"
        },
        "error": {
          "type": "string"
        }
      }
    }
  }
}

{
  "swagger": "2.0",
  "info": {
    "title": "Telemetry 上下文（领域模型 §2）：Event 流与日志查询面（日志/指标采集\n侧由 Logging/Metrics Capability 承载，本面是查询入口）。",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "EventsService"
    },
    {
      "name": "LogsService"
    },
    {
      "name": "MetricsService"
    },
    {
      "name": "AlertingService"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/v1/alerts": {
      "get": {
        "summary": "ListAlertStates 是现行告警状态面（含系统内置规则行）。",
        "operationId": "AlertingService_ListAlertStates",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListAlertStatesResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "tags": [
          "AlertingService"
        ]
      }
    },
    "/v1/alerts/rules": {
      "get": {
        "operationId": "AlertingService_ListAlertRules",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListAlertRulesResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "app_id",
            "description": "app_id 过滤（空 = 全部）。",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "AlertingService"
        ]
      },
      "post": {
        "summary": "CreateAlertRule 登记一条 per-App 阈值规则（评估在采集遍内原生完成）。",
        "operationId": "AlertingService_CreateAlertRule",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1CreateAlertRuleResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1CreateAlertRuleRequest"
            }
          }
        ],
        "tags": [
          "AlertingService"
        ]
      }
    },
    "/v1/alerts/rules/{rule_id}": {
      "delete": {
        "operationId": "AlertingService_DeleteAlertRule",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1DeleteAlertRuleResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "rule_id",
            "description": "rule_id 必填：目标规则行。",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "AlertingService"
        ]
      }
    },
    "/v1/channels": {
      "get": {
        "operationId": "AlertingService_ListNotificationChannels",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListNotificationChannelsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "tags": [
          "AlertingService"
        ]
      },
      "post": {
        "summary": "CreateNotificationChannel 登记一条通知通道（webhook/telegram；配置\nage 信封入库——URL/token 只写不读）。",
        "operationId": "AlertingService_CreateNotificationChannel",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1CreateNotificationChannelResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1CreateNotificationChannelRequest"
            }
          }
        ],
        "tags": [
          "AlertingService"
        ]
      }
    },
    "/v1/channels/{channel_id}": {
      "delete": {
        "operationId": "AlertingService_DeleteNotificationChannel",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1DeleteNotificationChannelResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "channel_id",
            "description": "channel_id 必填：目标通道行。",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "AlertingService"
        ]
      }
    },
    "/v1/channels/{channel_id}/test": {
      "post": {
        "summary": "TestNotificationChannel 即时发一条测试载荷（通道验收锚；配置错误\n原样上抛）。",
        "operationId": "AlertingService_TestNotificationChannel",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1TestNotificationChannelResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "channel_id",
            "description": "channel_id 必填：目标通道行。",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/AlertingServiceTestNotificationChannelBody"
            }
          }
        ],
        "tags": [
          "AlertingService"
        ]
      }
    },
    "/v1/events": {
      "get": {
        "operationId": "EventsService_ListEvents",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListEventsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "after_seq",
            "description": "after_seq 是游标（返回 seq 之后的事件，升序）。",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "int64"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          }
        ],
        "tags": [
          "EventsService"
        ]
      }
    },
    "/v1/events/status": {
      "get": {
        "summary": "GetEventStatus 是断档判定与快照重同步的基准面：earliest_seq 定保留窗\n起点（after_seq \u003c earliest 即断档），last_seq 定重同步后的新游标。",
        "operationId": "EventsService_GetEventStatus",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1GetEventStatusResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "tags": [
          "EventsService"
        ]
      }
    },
    "/v1/events/stream": {
      "get": {
        "summary": "StreamEvents 是订阅面（gRPC server-streaming；Console/Agent 的等待原语\n数据源）。follow=false 只重放保留窗随后收流；follow=true 持续跟随直至\n客户端取消。after_seq 落在保留窗外 → E_EVENTS_GONE（410，重同步）。",
        "operationId": "EventsService_StreamEvents",
        "responses": {
          "200": {
            "description": "A successful response.(streaming responses)",
            "schema": {
              "type": "object",
              "properties": {
                "result": {
                  "$ref": "#/definitions/v1StreamEventsResponse"
                }
              },
              "title": "Stream result of v1StreamEventsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "after_seq",
            "description": "after_seq 是游标（0 = 从保留窗最早开始；落在保留窗外 → 410）。",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "int64"
          },
          {
            "name": "follow",
            "description": "follow 持续跟随新事件（直至取消）；false = 重放保留窗后收流。",
            "in": "query",
            "required": false,
            "type": "boolean"
          }
        ],
        "tags": [
          "EventsService"
        ]
      }
    },
    "/v1/events/ticket": {
      "post": {
        "summary": "IssueEventTicket 为 SSE 订阅路径换一次性短时票据（ADR-0026：浏览器\nEventSource 不能设自定义头——Bearer 换秒级 TTL 单用途票据，SSE 以\nquery 参数携带；限订阅路径，泄漏面受控）。",
        "operationId": "EventsService_IssueEventTicket",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1IssueEventTicketResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1IssueEventTicketRequest"
            }
          }
        ],
        "tags": [
          "EventsService"
        ]
      }
    },
    "/v1/logs": {
      "get": {
        "operationId": "LogsService_StreamLogs",
        "responses": {
          "200": {
            "description": "A successful response.(streaming responses)",
            "schema": {
              "type": "object",
              "properties": {
                "result": {
                  "$ref": "#/definitions/v1StreamLogsResponse"
                }
              },
              "title": "Stream result of v1StreamLogsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "app_id",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "process",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "tail_lines",
            "description": "tail_lines 尾部行数（0 = 全量最近缓冲）；follow 持续跟随。",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "int64"
          },
          {
            "name": "follow",
            "in": "query",
            "required": false,
            "type": "boolean"
          },
          {
            "name": "since",
            "description": "since/until 是时间窗（RFC3339；空 = 不限）。实时路径（无 text）窗口\n作用于最近缓冲；text 检索路径窗口作用于保留窗（ADR-0040 双径）。",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "until",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "text",
            "description": "text 是文本过滤（ADR-0040 检索路径）：非空时经持久化日志存储全保留窗\n匹配；与 follow 组合 = 实时尾随检索（≥5s 批汇延迟）。",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "database_id",
            "description": "database_id 是 Database 域寻址（ADR-0029 域分立）：库载体日志通路，\n与 app_id/run_id 三轴互斥（IA v3 T8——Service 层 NamespaceRef 本有\nDatabase 域，本字段补 API 入口）。",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "run_id",
            "description": "run_id 是 Run 域寻址（ADR-0025 决策 4 词汇分立）：单 Run 载体日志，\n与 app_id/database_id 三轴互斥；归属 Task 经行链解析（NamespaceRef\n.Task 轴，拒塞 .App——同款词汇纪律）。",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "processes",
            "description": "processes 是多进程过滤（app 轴专用；ADR-0060 用户裁决，Console 日志\n工作台多选承载）：与单值 process 并集去重后收敛为 Workload ID 集\n（投影公式 engine.WorkloadID，空 = 本 App 全部 Workload）；database/\nrun 轴拒收（载体单 Workload）。gateway 传形 = 重复键\n（processes=a\u0026processes=b）——逗号形不分裂（REST 多进程测试钉此语义）。",
            "in": "query",
            "required": false,
            "type": "array",
            "items": {
              "type": "string"
            },
            "collectionFormat": "multi"
          },
          {
            "name": "containers",
            "description": "containers 是多实例过滤（ADR-0067 实例锚定日志）：载体归因标识直锚\n（swarm = task ID，k3s = pod 名——StreamLogsResponse.container 同源\n词汇，无派生公式），对该寻址轴收敛出的载体集做交集；空 = 全部副本\n容器。三轴通用（载体身份过滤不依赖 App 派生）；条目非空校验与\nprocesses 同纪律（精确拒绝）。gateway 传形 = 重复键。",
            "in": "query",
            "required": false,
            "type": "array",
            "items": {
              "type": "string"
            },
            "collectionFormat": "multi"
          }
        ],
        "tags": [
          "LogsService"
        ]
      }
    },
    "/v1/metrics": {
      "get": {
        "summary": "QueryMetrics 原样透传 PromQL（平台管理员诊断；member 调用 E_FORBIDDEN）。",
        "operationId": "MetricsService_QueryMetrics",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1QueryMetricsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "query",
            "description": "query 是 PromQL（原样透传；平台管理员诊断面，服务端不做行级约束）。\n必填：空查询无从起查。",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "start",
            "description": "start/end 是时间窗（RFC3339；空 end = 现在，空 start = end 前 1h）。",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "end",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "step_seconds",
            "description": "step_seconds 是采样步长（0 = 缺省 15s）。",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "int64"
          }
        ],
        "tags": [
          "MetricsService"
        ]
      }
    },
    "/v1/metrics/scoped": {
      "get": {
        "summary": "QueryScopedMetrics 按 App/Database 作用域查固定指标模板。\n授权：metrics:read + app/database 所在 Project 的行级 Team 比对。",
        "operationId": "MetricsService_QueryScopedMetrics",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1QueryScopedMetricsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": ".fleetly.shared.v1.ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "app_id",
            "description": "app_id/database_id/project_id 恰一非空（scope 互斥）。project scope 的\n指标白名单只有 cpu_cores/memory_working_set_bytes：project 汇总没有\n明确的 CPU 分母（cpu_percent 在受理面 E_INVALID_ARGUMENT），process\n维度也只在 app scope 存在。",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "database_id",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "metric",
            "description": "metric 白名单：cpu_percent | cpu_cores | memory_working_set_bytes\n（与告警规则 metric 词表同形；非法值在受理面 E_INVALID_ARGUMENT）。",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "process",
            "description": "process 仅 app scope 可用；小写 dns 形态（与 Process 名字符集同源）。",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "start",
            "description": "start/end 是 RFC3339；空 end = now，空 start = end 前 1h（与 raw 同）。",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "end",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "step_seconds",
            "description": "step_seconds 是请求步长；0 = 服务端按窗口自动，实际值会被钳制。",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "int64"
          },
          {
            "name": "project_id",
            "description": "project_id 是 project scope 的聚合轴（本队行级授权；成员可查本队）。",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "MetricsService"
        ]
      }
    }
  },
  "definitions": {
    "AlertingServiceTestNotificationChannelBody": {
      "type": "object"
    },
    "v1AlertRule": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "app_id": {
          "type": "string"
        },
        "metric": {
          "type": "string",
          "title": "metric: cpu_percent | memory_working_set_bytes（值域冻结）。"
        },
        "threshold": {
          "type": "number",
          "format": "double"
        },
        "for_seconds": {
          "type": "string",
          "format": "int64",
          "title": "for_seconds 是持续窗（连续越限 ≥ 本值才迁移 firing；0 = 立即；\n采样近似语义见 ADR-0041）。"
        },
        "enabled": {
          "type": "boolean"
        },
        "state": {
          "type": "string",
          "title": "state: ok | firing（现行评估态）。"
        },
        "state_since": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        }
      }
    },
    "v1AlertState": {
      "type": "object",
      "properties": {
        "rule_id": {
          "type": "string"
        },
        "app_id": {
          "type": "string"
        },
        "metric": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "state_since": {
          "type": "string"
        },
        "observed_value": {
          "type": "number",
          "format": "double",
          "title": "observed_value 是最近一次评估值（firing 判定依据；NaN = 无样本）。"
        },
        "system": {
          "type": "boolean",
          "title": "system 标记内置规则行（platform-offsite-backup；不可删）。"
        }
      }
    },
    "v1CreateAlertRuleRequest": {
      "type": "object",
      "properties": {
        "app_id": {
          "type": "string",
          "title": "app_id 必填：规则挂靠的 App（行级授权锚）。"
        },
        "metric": {
          "type": "string",
          "title": "metric: cpu_percent | memory_working_set_bytes（值域冻结；值域执法\n在服务内——文案带收到的原值回显）。"
        },
        "threshold": {
          "type": "number",
          "format": "double",
          "title": "threshold 是越限阈值（非负；0 = 任何达标观测即越限）。"
        },
        "for_seconds": {
          "type": "string",
          "format": "int64",
          "title": "for_seconds 是持续窗（连续越限 ≥ 本值才迁移 firing；0 = 立即；\n采样近似语义见 ADR-0041）。"
        }
      }
    },
    "v1CreateAlertRuleResponse": {
      "type": "object",
      "properties": {
        "rule": {
          "$ref": "#/definitions/v1AlertRule"
        }
      }
    },
    "v1CreateNotificationChannelRequest": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "title": "name 是通道名（全局唯一；人类引用锚）——dns 标签形态（小写字母数字\n与连字符，首尾字母数字，≤63 字符）是可读 id base 与派生名安全的前提。\n正则字面与长度界是 entityid.NamePatternSource / MaxNameLen 的镜像\n（proto 无法引用 Go 常量），字节一致由 entityid 包的 descriptor 对齐\n测试执法；空值报 required（本字段必填）。"
        },
        "kind": {
          "type": "string",
          "title": "kind: webhook | telegram（值域见 CONTEXT.md Notification Channel 词条；\n值域执法在服务内——文案带收到的原值回显）。"
        },
        "url": {
          "type": "string",
          "title": "webhook 形态：url 是接收端点（可含凭证查询串——age 信封入库）。"
        },
        "bot_token": {
          "type": "string",
          "title": "telegram 形态：bot_token 与 chat_id（age 信封入库）。"
        },
        "chat_id": {
          "type": "string"
        }
      }
    },

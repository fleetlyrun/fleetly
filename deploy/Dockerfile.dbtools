# fleetly dbtools —— 库备份/恢复作业镜像（E4 D-DB-6「执行体」裁决：
# 一次性 Swarm job 的运行载体 = 引擎工具 + restic，digest 钉定随平台发布；
# managed-databases 设计 §2.6）。
#
# 组合纪律：
#   - 全部 FROM 逐 digest 钉定（deploy/check-image-pins.sh 门禁域 = Dockerfile*）；
#   - 纯 COPY 无 RUN —— 多架构构建按目标平台自动解析各阶段（无需 QEMU），
#     构建零执行 = 构建环境零信任要求；
#   - **debian/glibc 基底（S2 v0.2.x，W4 遗留票落地）**：v0.2.0 是 alpine/
#     musl 基底，与引擎镜像（debian/glibc）跨 libc——pg 恢复的快照重放碰
#     collation version 解析失败与跨 libc 文本序索引损坏风险，W4 以双 job
#     （dbtools 取回 dump + 引擎镜像起临时实例重放）化解。基底改用与引擎
#     **同一钉定 digest** 的 postgres:16（glibc，16.15-trixie）后，dbtools
#     自带与引擎逐位一致的 pg_dump/pg_restore/psql，恢复回归**单 job**
#     （internal/database Restore）。
#   - redis-cli 改从 debian 版 redis:7 拷入（与 dbtemplate.DefaultRedisImage
#     同一钉定 digest）——musl 链接的 alpine redis-cli 在 glibc 基底不可运行；
#     restic 为 Go 静态二进制，任意基底可运行（来源镜像不变）。
#   - 体积注记（预算裁决 2026-09-23：opt-in/job 型组件不占 600MB 常驻预算
#     顶）：postgres debian 基底使最终镜像从 ~120MB 增至 ~400MB——本镜像是
#     一次性 job 执行体、非常驻，按需拉取用后即删，预算口径明示可接受。
#   - 工具面（引擎适配器的命令词表，internal/database S5 消费）：
#       pg_dump / pg_restore / psql / pg_isready / pg_ctl   （postgres:16
#       基底自带，/usr/local/bin——与引擎镜像同源同版）
#       redis-cli                     （/usr/local/bin/redis-cli）
#       restic                        （/usr/bin/restic → /usr/local/bin）
#       gosu                          （postgres 官方镜像自带——恢复重放的
#       降权执行依赖，internal/database 恢复词表消费）
#
# 发布：release.yml dbtools job（随平台 release 重建并钉新 digest）；本地
# 引导/演练构建用 buildx --push（见 runbook）。

FROM restic/restic:0.19.1@sha256:136600b6ff6843d61d355f7f71f460a166429f35de6fd11b568fece3c9a4d510 AS restic

FROM redis:7@sha256:c6eabf748fc7a61dbb5a705c78bcf3d6377b1127a97d0ce965c11c44ba46896f AS redis

FROM postgres:16@sha256:a3b7f434b2dc57ce85a67e171163eb8ab1a1ebcb39d27484661f26b1dfbe30d6

COPY --from=restic /usr/bin/restic /usr/local/bin/restic
COPY --from=redis /usr/local/bin/redis-cli /usr/local/bin/redis-cli

app (spec) — AppSpec: desired state of a long-running deployable unit (an app is one or more processes).
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "app": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "project": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "build": {
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "dockerfile"
          ]
        },
        {
          "required": [
            "railpack"
          ]
        }
      ],
      "properties": {
        "builder": {
          "type": "string"
        },
        "cache_from": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "dockerfile": {
          "type": "string"
        },
        "railpack": {
          "additionalProperties": false,
          "properties": {
            "pinned_version": {
              "type": "string"
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "first_boot_jobs": {
      "items": {
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "image"
            ]
          },
          {
            "required": [
              "from_build"
            ]
          }
        ],
        "properties": {
          "command": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "env": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "from_build": {
            "type": "string"
          },
          "image": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "secret_refs": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "ttl": {
            "format": "duration",
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "processes": {
      "items": {
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "image"
            ]
          },
          {
            "required": [
              "from_build"
            ]
          }
        ],
        "properties": {
          "command": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "config_refs": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "env": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "from_build": {
            "type": "string"
          },
          "healthcheck": {
            "additionalProperties": false,
            "oneOf": [
              {
                "required": [
                  "http_path"
                ]
              },
              {
                "required": [
                  "tcp_port"
                ]
              },
              {
                "required": [
                  "exec"
                ]
              }
            ],
            "properties": {
              "exec": {
                "additionalProperties": false,
                "properties": {
                  "command": {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  }
                },
                "type": "object"
              },
              "http_path": {
                "type": "string"
              },
              "interval": {
                "format": "duration",
                "type": "string"
              },
              "retries": {
                "type": "integer"
              },
              "start_period": {
                "format": "duration",
                "type": "string"
              },
              "tcp_port": {
                "type": "integer"
              },
              "timeout": {
                "format": "duration",
                "type": "string"
              }
            },
            "type": "object"
          },
          "image": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "networks": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "placement": {
            "additionalProperties": false,
            "properties": {
              "node_ids": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            },
            "type": "object"
          },
          "ports": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "port": {
                  "type": "integer"
                },
                "protocol": {
                  "enum": [
                    "PROTOCOL_UNSPECIFIED",
                    "PROTOCOL_HTTP",
                    "PROTOCOL_H2C",
                    "PROTOCOL_TCP"
                  ],
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "replicas": {
            "type": "integer"
          },
          "resources": {
            "additionalProperties": false,
            "properties": {
              "cpu_millis": {
                "type": "integer"
              },
              "memory_mb": {
                "type": "integer"
              }
            },
            "type": "object"
          },
          "secret_refs": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "volumes": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "read_only": {
                  "type": "boolean"
                },
                "target": {
                  "type": "string"
                },
                "volume_id": {
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "schema_version": {
      "type": "integer"
    },
    "source": {
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "git"
          ]
        },
        {
          "required": [
            "image"
          ]
        },
        {
          "required": [
            "upload"
          ]
        }
      ],
      "properties": {
        "git": {
          "additionalProperties": false,
          "properties": {
            "ref": {
              "type": "string"
            },
            "repo": {
              "type": "string"
            }
          },
          "type": "object"
        },
        "image": {
          "additionalProperties": false,
          "properties": {
            "ref": {
              "type": "string"
            }
          },
          "type": "object"
        },
        "upload": {
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string"
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    }
  },
  "type": "object"
}

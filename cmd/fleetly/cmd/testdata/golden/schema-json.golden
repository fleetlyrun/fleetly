    },
    {
      "name": "run.stopping",
      "kind": "event",
      "summary": "A run started stopping (stop reason carried on the row).",
      "schema_json": "{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"additionalProperties\":false,\"properties\":{\"dns_name\":{\"type\":\"string\"},\"exit_code\":{\"type\":\"integer\"},\"instance\":{\"type\":\"string\"},\"project_id\":{\"type\":\"string\"},\"run_id\":{\"type\":\"string\"},\"state\":{\"type\":\"string\"},\"stop_reason\":{\"type\":\"string\"},\"task_id\":{\"type\":\"string\"}},\"required\":[\"run_id\",\"task_id\",\"project_id\",\"state\"],\"type\":\"object\"}"
    },
    {
      "name": "schedule.created",

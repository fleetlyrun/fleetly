    },
    {
      "name": "team.created",
      "kind": "event",
      "summary": "A team was created.",
      "schema_json": "{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"additionalProperties\":false,\"properties\":{\"name\":{\"type\":\"string\"}},\"required\":[\"name\"],\"type\":\"object\"}"
    },
    {
      "name": "token.created",
      "kind": "event",
      "summary": "A token was minted (secret shown once at creation).",
      "schema_json": "{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"additionalProperties\":false,\"properties\":{\"name\":{\"type\":\"string\"}},\"required\":[\"name\"],\"type\":\"object\"}"
    },
    {
      "name": "token.revoked",
      "kind": "event",
      "summary": "A token was revoked; its next call will be rejected.",
      "schema_json": "{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"null\"}"
    },
    {
      "name": "upload.stored",
      "kind": "event",
      "summary": "An uploaded source was stored (content-addressed; payload carries id, digest, size and deduplicated).",
      "schema_json": "{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"additionalProperties\":false,\"properties\":{\"deduplicated\":{\"type\":\"boolean\"},\"digest\":{\"type\":\"string\"},\"id\":{\"type\":\"string\"},\"project_id\":{\"type\":\"string\"},\"size_bytes\":{\"type\":\"integer\"}},\"required\":[\"id\",\"project_id\",\"digest\",\"size_bytes\",\"deduplicated\"],\"type\":\"object\"}"
    },
    {
      "name": "user.created",
      "kind": "event",
      "summary": "A user was created and granted a role in a team.",
      "schema_json": "{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"additionalProperties\":false,\"properties\":{\"name\":{\"type\":\"string\"}},\"required\":[\"name\"],\"type\":\"object\"}"
    },
    {
      "name": "volume.created",
      "kind": "event",
      "summary": "A volume was created.",
      "schema_json": "{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"additionalProperties\":false,\"properties\":{\"active_deployments\":{\"type\":\"integer\"},\"id\":{\"type\":\"string\"},\"project_id\":{\"type\":\"string\"}},\"required\":[\"id\"],\"type\":\"object\"}"
    },
    {
      "name": "workload.drift_detected",
      "kind": "event",
      "summary": "Observed workload diverged from the ensured generation or spec (ADR-0022).",
      "schema_json": "{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"additionalProperties\":false,\"properties\":{\"app_id\":{\"type\":\"string\"},\"expected_generation\":{\"type\":\"integer\"},\"message\":{\"type\":\"string\"},\"observed_generation\":{\"type\":\"integer\"},\"observed_state\":{\"type\":\"string\"},\"workload_id\":{\"type\":\"string\"}},\"required\":[\"workload_id\",\"expected_generation\",\"observed_generation\",\"observed_state\"],\"type\":\"object\"}"
    },
    {
      "name": "workload.stopped",
      "kind": "event",
      "summary": "A steady-state workload was observed stopped at the current generation.",
      "schema_json": "{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"additionalProperties\":false,\"properties\":{\"app_id\":{\"type\":\"string\"},\"generation\":{\"type\":\"integer\"},\"message\":{\"type\":\"string\"},\"state\":{\"type\":\"string\"},\"workload_id\":{\"type\":\"string\"}},\"required\":[\"workload_id\",\"generation\",\"state\"],\"type\":\"object\"}"
    }
  ]
}

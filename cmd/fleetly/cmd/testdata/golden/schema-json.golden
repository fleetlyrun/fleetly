pe\":\"object\"},\"secret_refs\":{\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"volumes\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"read_only\":{\"type\":\"boolean\"},\"target\":{\"type\":\"string\"},\"volume_id\":{\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"}},\"type\":\"object\"},\"schema_version\":{\"type\":\"integer\"},\"task\":{\"additionalProperties\":false,\"properties\":{\"id\":{\"type\":\"string\"},\"project\":{\"type\":\"string\"}},\"type\":\"object\"},\"ttl_seconds\":{\"type\":\"integer\"}},\"type\":\"object\"}"
    },
    {
      "name": "task.active",
      "kind": "event",
      "summary": "A drained task was revived by an owner lease renewal.",

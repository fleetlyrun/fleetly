      "schema_json": "{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"additionalProperties\":false,\"properties\":{\"user\":{\"type\":\"string\"}},\"required\":[\"user\"],\"type\":\"object\"}"
    },
    {
      "name": "invitation.created",
      "kind": "event",

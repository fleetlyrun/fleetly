          "id": "8.4"
        },
        {
          "id": "9",
          "default": true
        }
      ],
      "knobs": [
        {
          "key": "max_connections",
          "kind": "int",
          "default_value": "151",
          "class": "dynamic",
          "category": "connections"
        },
        {
          "key": "innodb_buffer_pool_size",
          "kind": "size",
          "default_value": "128mb",
          "class": "dynamic",
          "category": "memory"
        }
      ],
      "port": 3306,
      "capabilities": {
        "backup": true,
        "browse": true,
        "restore_compat": true
      }
    },
    {
      "family": "database",

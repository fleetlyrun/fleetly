    },
    {
      "family": "database",
      "engine": "redis",
      "dialect": "redis",
      "versions": [
        {
          "id": "7.4"
        },
        {
          "id": "8.2",
          "default": true
        }
      ],
      "knobs": [
        {
          "key": "appendonly",
          "kind": "bool",
          "default_value": "true",
          "class": "static",
          "category": "persistence"
        },
        {
          "key": "maxmemory",
          "kind": "size",
          "class": "static",
          "category": "memory"
        },
        {
          "key": "maxmemory-policy",
          "kind": "enum",
          "enum_values": [
            "noeviction",
            "allkeys-lru",
            "allkeys-lfu",
            "volatile-lru",
            "volatile-lfu",
            "volatile-ttl",
            "volatile-random",
            "allkeys-random"
          ],
          "default_value": "noeviction",
          "class": "static",
          "category": "memory"
        }
      ],
      "port": 6379,
      "capabilities": {
        "backup": true,
        "browse": true,
        "restore_compat": true
      }
    },

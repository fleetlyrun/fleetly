          "id": "8.2",
          "default": true
        }
      ],
      "port": 27017,
      "capabilities": {
        "backup": true,
        "browse": true,
        "restore_compat": true
      }
    },
    {
      "family": "database",
      "engine": "mysql",
      "dialect": "mysql",
      "versions": [

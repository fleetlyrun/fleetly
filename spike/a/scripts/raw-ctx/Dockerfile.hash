FROM alpine:3.20
WORKDIR /work
# Mitigation pattern (what railpack does internally via /secrets-hash):
# fold a HASH of the secret into a layer-visible ARG so that cache
# invalidates exactly when the secret changes. Only the hash (never the
# value) lands in history.
ARG NPM_TOKEN_HASH=none
COPY payload.txt .
RUN echo "$NPM_TOKEN_HASH" > /work/.token-hash
RUN --mount=type=secret,id=npm_token \
    set -e; \
    TOK=$(cat /run/secrets/npm_token); \
    echo "fingerprint:$(echo "$TOK" | sha256sum | cut -c1-12)" > /work/manifest.txt; \
    sleep 3
CMD ["cat","/work/manifest.txt"]
